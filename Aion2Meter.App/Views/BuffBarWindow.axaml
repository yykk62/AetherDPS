<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aion2Meter.App.ViewModels"
        x:Class="Aion2Meter.App.Views.BuffBarWindow"
        x:DataType="vm:BuffBarViewModel"
        SystemDecorations="None" ShowActivated="False" Topmost="True" ShowInTaskbar="False"
        CanResize="False" Width="260" SizeToContent="Height"
        TransparencyLevelHint="Transparent" Background="Transparent">
  <Border Background="#C8141820" CornerRadius="6" Padding="6" IsVisible="{Binding HasItems}">
    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:BuffBarRow">
          <Panel Height="18" Margin="0,1">
            <ProgressBar MinHeight="0" Height="18" Maximum="1" Value="{Binding Fraction}" Foreground="#E0A84A"
                         Background="#22FFFFFF" CornerRadius="3" Opacity="0.55" />
            <Grid ColumnDefinitions="*,Auto" Margin="6,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#E6E8EC" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Remaining}" FontSize="11" FontWeight="SemiBold" Foreground="#E6E8EC" Margin="6,0,0,0" />
            </Grid>
          </Panel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</Window>
