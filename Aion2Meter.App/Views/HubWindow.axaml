<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aion2Meter.App.ViewModels"
        xmlns:views="using:Aion2Meter.App.Views"
        xmlns:l="using:Aion2Meter.App.Services"
        x:Class="Aion2Meter.App.Views.HubWindow"
        x:DataType="vm:HubViewModel"
        Title="{l:T hub.title}"
        Width="860" Height="600" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#11141B" Icon="/Assets/icon.ico">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E6E8EC" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#8E96A3" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#191E28" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BorderBrush" Value="#232A36" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#E0A84A" />
      <Setter Property="Foreground" Value="#141820" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="20,9" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0BC62" />
      <Setter Property="Foreground" Value="#141820" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="#8E96A3" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#E6E8EC" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="#E0A84A" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="#191E28" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="BorderBrush" Value="#232A36" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- Kopf -->
    <Grid ColumnDefinitions="*,Auto" Margin="22,16,22,4">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Image Source="/Assets/icon.png" Width="28" Height="28" />
        <TextBlock Text="{l:T hub.title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="{l:T hub.close_hint}" Classes="dim" FontSize="11" VerticalAlignment="Center" Margin="12,2,0,0" />
      </StackPanel>
      <!-- Update bereit -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                  IsVisible="{Binding UpdateBanner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding UpdateBanner}" Foreground="#E0A84A" FontSize="12" VerticalAlignment="Center" />
        <Button Classes="primary" Content="{l:T update.restart_short}" Command="{Binding RestartForUpdateCommand}" />
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1" TabStripPlacement="Left" SelectedIndex="{Binding SelectedTab}" Margin="10,6,0,0">

      <!-- DPS-Meter -->
      <TabItem Header="{l:T hub.tab.dps}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="12,4,22,22">
            <Border Classes="card">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,12,0"
                         Fill="{Binding IsActive, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
                <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,16,0">
                  <TextBlock Text="{Binding ModeTitle}" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ModeText}" Classes="dim" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RiftInfo}" Foreground="#E0A84A" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button Classes="secondary" Content="{Binding LaunchText}" Command="{Binding LaunchGameCommand}" IsEnabled="{Binding !GameRunning}" />
                    <TextBlock Text="{l:T hub.launch_hint}" Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="380" />
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Classes="primary" Content="{Binding ToggleText}" Command="{Binding ToggleMeterCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="{l:T hub.run.title}" />
                <TextBlock Text="{Binding RunSummary}" Classes="dim" IsVisible="{Binding HasRun}" />
                <TextBlock Text="{l:T hub.run.empty}" Classes="dim" IsVisible="{Binding !HasRun}" />
                <TextBlock Text="{Binding BuffDiagnostics}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding RunPlayers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                      <Border Height="30" CornerRadius="4" Background="#14FFFFFF" Margin="0,0,0,3">
                        <Panel>
                          <ProgressBar Height="30" MinHeight="0" Maximum="100" Value="{Binding BarPercent}" Foreground="{Binding ClassBrush}"
                                       Background="Transparent" Opacity="0.35" CornerRadius="4" />
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="6,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Image Source="{Binding ClassIcon}" Width="22" Height="22" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding ClassName}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Dps}" FontWeight="SemiBold" MinWidth="70" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding Total}" Classes="dim" MinWidth="60" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding Share}" Classes="dim" MinWidth="56" TextAlignment="Right" />
                          </Grid>
                        </Panel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="2,0,8,0"
                       Fill="{Binding Overlay.IsConnected, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
              <TextBlock Grid.Column="1" Text="{Binding Overlay.StatusText}" Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Classes="secondary" Content="{l:T hub.report}" Command="{Binding ReportProblemCommand}" Margin="8,0,0,0" />
              <Button Grid.Column="3" Classes="secondary" Content="{l:T hub.folder}" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{l:T hub.tab.runs}">
        <views:RunsView DataContext="{Binding Runs}" />
      </TabItem>

      <TabItem Header="{l:T hub.tab.party}">
        <views:PartyView DataContext="{Binding Party}" />
      </TabItem>

      <TabItem Header="{l:T hub.tab.timers}">
        <views:TimersView DataContext="{Binding Timers}" />
      </TabItem>

      <TabItem Header="{l:T hub.tab.checklist}">
        <views:ChecklistView DataContext="{Binding Checklist}" />
      </TabItem>

      <!-- Verbindung -->
      <TabItem Header="{l:T hub.tab.connection}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="12,4,22,22">
            <Grid ColumnDefinitions="*,*,*,*,*">
              <Border Grid.Column="0" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.now}" /><TextBlock Text="{Binding PingNow}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="1" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.avg}" /><TextBlock Text="{Binding PingAvg}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="2" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.jitter}" /><TextBlock Text="{Binding PingJitter}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="3" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.spikes}" /><TextBlock Text="{Binding SpikeCount}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="4" Classes="tile" Margin="0"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.retrans}" /><TextBlock Text="{Binding Retransmits}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
            </Grid>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h2" Text="{l:T conn.graph}" />
                  <TextBlock Grid.Column="1" Classes="dim" FontSize="11" Text="{Binding ServerText}" VerticalAlignment="Center" />
                </Grid>
                <Panel Height="190">
                  <views:PingGraph Samples="{Binding PingSamples}" SpikeThreshold="{Binding SpikeThreshold}" />
                  <TextBlock Text="{l:T conn.no_data}" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasPingData}" />
                </Panel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h2" Text="{l:T conn.check}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="primary" Content="{l:T conn.check}" Command="{Binding DiagnoseCommand}" IsEnabled="{Binding !IsDiagnosing}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding DiagnosisRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiagnosisRow">
                      <Grid ColumnDefinitions="Auto,170,*" Margin="0,3">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Fill="{Binding Ok, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding Result}" Classes="dim" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding DiagnosisText}" TextWrapping="Wrap" FontSize="13" />
                <TextBlock Text="{l:T conn.note}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Einstellungen -->
      <TabItem Header="{l:T hub.tab.settings}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <Border Classes="card" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="460" Margin="12,4,22,22">
            <views:SettingsView DataContext="{Binding Settings}" />
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
