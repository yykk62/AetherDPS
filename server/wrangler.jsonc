{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aetherdps-api",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // Keine Wrangler-Telemetrie.
  "send_metrics": false,

  // Wir versprechen, nichts zu protokollieren: Workers Logs und Logpush bleiben aus.
  "observability": { "enabled": false },
  "logpush": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aetherdps",
      // Nach `wrangler d1 create aetherdps` die ausgegebene ID hier eintragen.
      "database_id": "f25930e6-32e4-4189-a305-b4622dbef9e7"
    }
  ],

  // Begrenzung pro Minute je Absender (nur im Speicher). Die Tagesgrenzen stehen in src/index.ts (Tabellen senders/day_salt).
  "ratelimits": [
    { "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "PING_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    // /api/character: je IP 10 Abrufe pro Minute; zu NCSOFT insgesamt höchstens 10 Anfragen je 10 Sekunden (Schlüssel "ncsoft").
    { "name": "CHARACTER_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "NCSOFT_LIMIT", "namespace_id": "1004", "simple": { "limit": 10, "period": 10 } }
  ]

  // Secrets (nicht hier eintragen!): ADMIN_KEY, BOT_KEY (gleicher Wert wie im Worker aetherdps-discord)  ->  `wrangler secret put …`
}
