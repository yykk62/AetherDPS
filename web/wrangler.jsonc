{
  // Webseite: nur statische Dateien aus dist/ (npm run build), ausgeliefert unter aetherdps.com.
  "name": "aetherdps-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "aetherdps.com", "custom_domain": true },
    { "pattern": "www.aetherdps.com", "custom_domain": true }
  ],
  "workers_dev": false
}
