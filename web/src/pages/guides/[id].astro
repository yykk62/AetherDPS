---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { t } from '../../i18n';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => !g.data.draft);
  return guides.map((guide) => ({ params: { id: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const date = new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' });
---
<Base title={guide.data.title} description={guide.data.description}>
  <div class="wrap">
    <PageHead image="/img/guides.webp" eyebrow={t('guides.title')} title={guide.data.title} lead={guide.data.description}>
      <p class="muted small">{t('guides.updated')} {date.format(guide.data.updated)}</p>
    </PageHead>
    <article class="prose">
      <Content />
    </article>
    <p><a href="/guides">← {t('guides.title')}</a></p>
  </div>
</Base>

<style>
  .prose { max-width: 760px; }
  .prose :global(h2) { margin-top: 2rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(pre) { background: var(--panel) !important; border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; overflow-x: auto; }
  .prose :global(pre code) { background: none; padding: 0; }
</style>
