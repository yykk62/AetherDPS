---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Divider from '../components/Divider.astro';
import { t } from '../i18n';

const DOWNLOAD = 'https://github.com/yykk62/AetherDPS/releases/latest';

// Icons: eigenes Emblem-Set (assets/brand, public/gen/brand)
const web = [
  ['hourglass', t('nav.timer'), 'Risse, Weltbosse, Shugofesta und Abyss live in deiner Ortszeit.', '/timer'],
  ['checklist', t('nav.checklist'), 'Tägliches und Wöchentliches für Main und Twinks, setzt sich selbst zurück.', '/checkliste'],
  ['cheatsheet', t('nav.cheatsheet'), 'Leveling, Level 45, Währungen und Abyss auf einen Blick.', '/cheat-sheet'],
  ['dragon', t('db.fieldbosses'), 'Alle Feldbosse je Gebiet mit Respawn und festen Zeiten.', '/datenbank/feldbosse'],
  ['paw', t('db.pets'), 'Alle Pets mit Gattung, Gebiet und dem Monster, das die Seele droppt.', '/datenbank/pets'],
  ['book', t('nav.guides'), 'Anleitungen rund um AION 2 und AetherDPS.', '/guides'],
];

const app = [
  ['swords', 'Live-DPS-Meter', 'Boss mit Lebens- und Stagger-Balken, Schaden, DPS und Anteil deiner Gruppe, Skills mit echten Skill-Bildern.'],
  ['trophy', 'Urteil nach dem Lauf', 'Neue Bestzeit? Mehr DPS als sonst? Verglichen mit deinen Läufen derselben Kategorie, dazu die Kampfanalyse je Spieler.'],
  ['helmet', 'Profil mit Verlauf', 'Ausrüstung, Werte, Daevanion und Skills ohne laufendes Spiel, dazu der Verlauf deiner Kampfkraft.'],
  ['group', 'Neu in der Gruppe', 'Tritt jemand bei, siehst du sofort Kampfkraft, Gear Score und Waffe.'],
  ['compass', 'Pet-Radar', 'Die fehlenden Pets in deiner Nähe als Minimap mit Entfernung und Richtung.'],
  ['bell', 'Timer-Pills', 'Echte Respawn-Zeiten der Feldbosse direkt vom Server, frei über dem Spiel platziert.'],
  ['signal', 'Verbindung', 'Ping-Verlauf und Lag-Spitzen: liegt es an dir, am Anbieter oder am Spielserver?'],
  ['globe', '10 Sprachen', 'Oberfläche, Skills, Monster und Dungeons in deiner Sprache. Updates kommen von selbst.'],
];

// Rundgang durch die App: Bilder aus docs/media (README-Bilder, tools/readme-media.py)
const tour = [
  ['jetzt', 'Jetzt', 'hero.png', 'Nach dem Lauf: das Urteil, deine DPS und Zeit auf einer Messlatte gegen deine früheren Läufe, daneben, was als Nächstes ansteht.'],
  ['kaempfe', 'Kämpfe', 'runs.png', 'Alle Läufe nach Tagen mit Bestzeit, Boss-Zeiten und Kampfanalyse. Als Bild oder Text für Discord kopieren.'],
  ['profil', 'Profil', 'profile.png', 'Dein Charakter oder jeder andere auf einem EU-Server: Ausrüstung, Werte und der Verlauf deiner Kampfkraft.'],
  ['pets', 'Pets', 'pets.png', 'Alle Pets mit deiner Stufe und ihren Spawnpunkten auf der Karte.'],
  ['timer', 'Timer', 'timers.png', 'Feldbosse mit echten Respawn-Zeiten vom Server, Risse, Belagerung und eigene Countdowns.'],
  ['verbindung', 'Verbindung', 'connection.png', 'Ping-Verlauf mit Lag-Spitzen und der Antwort, woran es liegt.'],
];

// Was AetherDPS von anderen Metern abhebt (Abgleich mit ~30 Tools am 15.10.2026). Bewusst ohne „als einziger“.
const why = [
  ['stagger', 'Stagger je Spieler', 'Nach jeder Stagger-Phase siehst du, ob sie geklappt hat und wer wie viel dazu beigetragen hat. Schluss mit „wer hat nicht gestaggert?“.'],
  ['lag', 'Warum laggt es?', 'Verbindung prüfen sagt dir, ob es an deinem Heimnetz, deinem Internetanbieter oder am Spielserver liegt.'],
  ['group', 'Neu in der Gruppe', 'Tritt jemand bei, erscheinen sofort Kampfkraft, Gear Score, Verzauberung und Waffe. Ein Klick öffnet das ganze Profil.'],
  ['patch', 'Ehrlich nach Patches', 'Versteht der Meter das Spiel nach einem Patch nicht mehr, sagt er es dir, statt still falsche oder leere Zahlen zu zeigen.'],
  ['lock', 'Deine Daten bleiben bei dir', 'Keine Uploads, keine Bestenlisten, kein Konto. Deine Kämpfe und die Namen deiner Mitspieler verlassen nie deinen PC.'],
];

const faq = [
  ['Ist das erlaubt?', 'Der Meter liest den Netzwerkverkehr nur passiv mit. Er verändert nichts am Spiel, liest keinen Spielspeicher und sendet nichts ans Spiel. Inoffizielles Fan-Projekt, Nutzung auf eigene Verantwortung.'],
  ['Was kostet das?', 'Nichts. Der Quellcode ist offen (GPL-3.0), jeder kann nachsehen, was das Programm tut.'],
  ['Werden meine Daten hochgeladen?', 'Deine Kampfdaten nie. Kein Konto, keine Bestenliste. Was die App ins Internet schickt, steht vollständig in der Datenschutzerklärung.'],
  ['Warum warnt Windows beim ersten Start?', 'Die Datei ist noch nicht digital signiert. Auf „Weitere Informationen“ → „Trotzdem ausführen“ klicken.'],
];
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div class="hero-text">
        <div class="eyebrow">AION 2 · EU</div>
        <h1>{t('site.tagline')}</h1>
        <p class="lead">Live-DPS über dem Spiel, Timer, Pets und Checkliste. Deine Kampfdaten bleiben auf deinem PC.</p>
        <div class="cta">
          <a class="btn" href={DOWNLOAD}><Icon name="download" size={22} /> {t('home.download')}</a>
          <a class="btn ghost" href="/timer">{t('nav.timer')} ansehen</a>
          <a class="btn ghost" href="https://discord.gg/xExgsyDEP2"><Icon name="chat" size={22} /> {t('home.discord')}</a>
        </div>
        <p class="muted small">{t('home.free')}</p>
      </div>
    </div>
  </section>

  <section class="section art art-aether">
    <div class="wrap">
      <div class="eyebrow">Warum AetherDPS?</div>
      <h2 class="why-title">Was AetherDPS besonders macht</h2>
      <div class="radar">
        <img src="/gen/media/radar.gif" alt="Pet-Radar unterwegs: die Minimap folgt dir, Entfernungen laufen mit" loading="lazy" />
        <div>
          <h3 class="with-icon"><Icon name="compass" size={36} /> Das Pet-Radar ersetzt deine Karte</h3>
          <p>Öffnest du im Spiel die Karte, liegt das Radar genau darüber, so groß wie sie. Es folgt dir live, auch im Flug, und zeigt die Pets, die dir noch fehlen, mit <strong>Entfernung, Richtung und dem Monster, das die Seele droppt</strong>.</p>
          <p>Kein Extra-Knopf, kein Hotkey, kein Umschalten: Karte auf, Pets finden. Auf Wunsch bleibt es auch dauerhaft als Minimap stehen.</p>
        </div>
      </div>
      <div class="grid why">
        {why.map(([icon, title, text]) => (
          <div class="card">
            <h3 class="with-icon"><Icon name={icon} size={30} /> {title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="wrap">
    <Divider />
    <section class="section">
      <h2>{t('home.webTitle')}</h2>
      <p class="muted">{t('home.webText')}</p>
      <div class="grid">
        {web.map(([icon, title, text, href]) => (
          <a class="card feature" href={href}>
            <Icon name={icon} size={56} class="icon" />
            <h3>{title}</h3>
            <p>{text}</p>
          </a>
        ))}
      </div>
    </section>
    <Divider />
  </div>

  <section class="section art art-wings">
    <div class="wrap">
      <h2>{t('home.appTitle')}</h2>
      <div class="tour">
        {tour.map(([id, , , ], i) => <input type="radio" name="tour" id={`tour-${id}`} checked={i === 0} />)}
        <div class="tour-tabs" role="tablist">
          {tour.map(([id, label]) => <label for={`tour-${id}`}>{label}</label>)}
        </div>
        {tour.map(([id, label, img, text], i) => (
          <figure class={`tour-shot tour-${id}`}>
            <img src={`/gen/media/${img}`} alt={`AetherDPS: ${label}. ${text}`} loading={i === 0 ? 'eager' : 'lazy'} />
            <figcaption>{text}</figcaption>
          </figure>
        ))}
      </div>
      <div class="showcase">
        <img src="/gen/media/overlay.gif" alt="Live-Meter im Bosskampf" loading="lazy" />
        <div class="grid compact">
          {app.map(([icon, title, text]) => (
            <div class="card">
              <h3 class="with-icon"><Icon name={icon} size={30} /> {title}</h3>
              <p>{text}</p>
            </div>
          ))}
        </div>
      </div>
      <p><a class="btn" href={DOWNLOAD}><Icon name="download" size={22} /> {t('home.download')}</a></p>
    </div>
  </section>

  <section class="section art art-stars">
    <div class="wrap">
      <h2>{t('home.faqTitle')}</h2>
      {faq.map(([q, a]) => (
        <details class="faq">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: min(78vh, 680px); display: flex; align-items: center; padding: 64px 0 48px;
    background:
      linear-gradient(90deg, var(--bg) 0%, rgba(16, 19, 26, 0.88) 28%, rgba(16, 19, 26, 0.2) 62%, transparent 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 35%),
      url(/img/hero.webp) 75% 30% / cover no-repeat;
  }
  .hero > .wrap { width: 100%; }
  .hero-text { max-width: 560px; }
  .hero h1 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); text-shadow: 0 2px 16px rgba(0, 0, 0, 0.6); }
  .lead { color: var(--soft); font-size: 1.1rem; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.8); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin: 20px 0 10px; }
  .why-title { margin-top: 0; }
  .grid.why { grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); }
  .radar {
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: center;
    background: linear-gradient(135deg, rgba(25, 30, 40, 0.92), rgba(25, 30, 40, 0.75));
    border: 1px solid var(--gold); border-radius: var(--radius); padding: 20px; margin-bottom: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
  }
  .radar img { border-radius: 10px; }
  .radar h3 { font-size: 1.3rem; color: var(--gold-2); }
  .radar p { color: var(--soft); }
  .radar p:last-child { margin: 0; }
  @media (max-width: 760px) { .radar { grid-template-columns: 1fr; } }
  .tour { margin-bottom: 24px; }
  .tour > input { position: absolute; opacity: 0; pointer-events: none; }
  .tour-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .tour-tabs label {
    cursor: pointer; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--line);
    background: rgba(25, 30, 40, 0.85); color: var(--soft); font-weight: 600; font-size: 0.95rem;
  }
  .tour-tabs label:hover { color: var(--gold-2); border-color: var(--gold); }
  .tour-shot { display: none; margin: 0; }
  .tour-shot img {
    display: block; width: 100%; height: auto; max-height: 78vh; object-fit: cover; object-position: top;
    border-radius: 12px; border: 1px solid var(--line); background: #0d0f15; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .tour-shot figcaption { color: var(--soft); margin-top: 10px; }
  #tour-jetzt:checked ~ .tour-jetzt { display: block; }
  #tour-jetzt:checked ~ .tour-tabs label[for=tour-jetzt] { color: var(--bg); background: var(--gold); border-color: var(--gold); }
  #tour-kaempfe:checked ~ .tour-kaempfe { display: block; }
  #tour-kaempfe:checked ~ .tour-tabs label[for=tour-kaempfe] { color: var(--bg); background: var(--gold); border-color: var(--gold); }
  #tour-profil:checked ~ .tour-profil { display: block; }
  #tour-profil:checked ~ .tour-tabs label[for=tour-profil] { color: var(--bg); background: var(--gold); border-color: var(--gold); }
  #tour-pets:checked ~ .tour-pets { display: block; }
  #tour-pets:checked ~ .tour-tabs label[for=tour-pets] { color: var(--bg); background: var(--gold); border-color: var(--gold); }
  #tour-timer:checked ~ .tour-timer { display: block; }
  #tour-timer:checked ~ .tour-tabs label[for=tour-timer] { color: var(--bg); background: var(--gold); border-color: var(--gold); }
  #tour-verbindung:checked ~ .tour-verbindung { display: block; }
  #tour-verbindung:checked ~ .tour-tabs label[for=tour-verbindung] { color: var(--bg); background: var(--gold); border-color: var(--gold); }
  .tour > input:focus-visible ~ .tour-tabs { outline: 2px solid var(--gold); outline-offset: 4px; border-radius: 999px; }
  @media (max-width: 760px) {
    .hero {
      align-items: flex-end; padding-top: 220px;
      background:
        linear-gradient(0deg, var(--bg) 0%, rgba(16, 19, 26, 0.75) 55%, rgba(16, 19, 26, 0.1) 100%),
        url(/img/hero.webp) 70% 20% / cover no-repeat;
    }
  }
  .showcase { display: grid; gap: 20px; grid-template-columns: 1fr 1fr; align-items: start; margin-bottom: 20px; }
  .showcase > img { border-radius: 12px; border: 1px solid var(--line); }
  .grid.compact { grid-template-columns: 1fr 1fr; gap: 12px; }
  .grid.compact .card { padding: 14px; }
  .faq { background: rgba(25, 30, 40, 0.85); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 16px; margin-bottom: 8px; }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq p { margin: 10px 0 0; color: var(--soft); }
  @media (max-width: 860px) {
    .showcase { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .grid.compact { grid-template-columns: 1fr; }
  }
</style>
