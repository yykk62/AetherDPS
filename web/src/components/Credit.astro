---
// Nennung von Wakayashi auf jeder Seite, die Inhalte von wakayashi.gg nutzt (Erlaubnis liegt vor).
// Bewusst kurz: nur „Inhalte von Wakayashi“ mit Link (Wunsch des Nutzers).
import { t } from '../i18n';
interface Props { href?: string }
const { href = 'https://wakayashi.gg/aion2' } = Astro.props;
---
<div class="credit">
  <span>{t('common.thanks')} <a href={href} rel="noopener">Wakayashi</a></span>
</div>
