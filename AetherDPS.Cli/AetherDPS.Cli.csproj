<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>aetherdps-cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherDPS.Engine\AetherDPS.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Texte, z. B. für „presence“ (Rich Presence ohne Fenster prüfen) -->
    <None Include="..\AetherDPS.App\Lang\*.json" Link="Lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
