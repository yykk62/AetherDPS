<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherDPS.App.ViewModels"
             xmlns:views="using:AetherDPS.App.Views"
             xmlns:l="using:AetherDPS.App.Services"
             x:Class="AetherDPS.App.Views.PetsView"
             x:DataType="vm:PetsViewModel">
  <UserControl.Styles>
    <!-- Knopfleiste statt Dropdown: ein ListBox mit nebeneinander gleich breiten Feldern -->
    <Style Selector="ListBox.seg">
      <Setter Property="Background" Value="#14181F" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.seg ListBoxItem">
      <Setter Property="Padding" Value="4,5" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.seg ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A3120" />
    </Style>
    <Style Selector="ListBox.seg ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="#E0A84A" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#262D3A" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="Margin" Value="0,0,4,4" />
    </Style>
  </UserControl.Styles>

  <!-- Alles passt ins Fenster, nichts scrollt außen: Liste und Karte füllen die Höhe -->
  <Grid RowDefinitions="Auto,*" Margin="12,4,22,22">

    <!-- Pet-Radar im Spiel -->
    <Border Classes="card" Padding="14,10" Margin="0,0,0,12" ToolTip.Tip="{l:T radar.enable_hint}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border Width="34" Height="34" CornerRadius="17" Background="#2A2416" VerticalAlignment="Center">
          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon center, Size=20}" Width="20" Height="20" HorizontalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{l:T radar.settings_title}" FontWeight="SemiBold" />
          <TextBlock Text="{l:T radar.short_hint}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <ComboBox Grid.Column="2" ItemsSource="{Binding RadarModes}" SelectedItem="{Binding SelectedRadarMode}" MinWidth="250" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="290,*" ColumnSpacing="12">

      <!-- Liste -->
      <Border Classes="card" Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
          <TextBlock Classes="h2" Text="{l:T pets.title}" Margin="0,0,0,8" />
          <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,6">
            <!-- Karte: nur die der eigenen Seite (+ Abyss) -->
            <ListBox Classes="seg" ItemsSource="{Binding MapOptions}" SelectedItem="{Binding SelectedMap}" IsVisible="{Binding HasMapChoice}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PetMapOption">
                  <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- Gattung: Bild-Knöpfe -->
            <ListBox Classes="seg" ItemsSource="{Binding SpeciesOptions}" SelectedItem="{Binding SelectedSpecies}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SpeciesOption">
                  <Panel ToolTip.Tip="{Binding Name}" Height="30">
                    <TextBlock Text="{l:T pets.filter_short.all}" FontSize="12" IsVisible="{Binding IsAll}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Border Width="30" Height="30" CornerRadius="15" ClipToBounds="True" BorderBrush="{Binding Brush}" BorderThickness="2"
                            IsVisible="{Binding !IsAll}" Background="#22000000">
                      <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                    </Border>
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- Stand: alle / fehlen / nicht max -->
            <ListBox Classes="seg" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PetFilterOption">
                  <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <TextBox Grid.Row="2" Text="{Binding Search}" Watermark="{l:T pets.search}" Margin="0,0,0,6" />
          <StackPanel Grid.Row="3" Spacing="2" Margin="2,0,0,6">
            <TextBlock Text="{Binding Summary}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LevelsHint}" Foreground="#E0A84A" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding LevelsHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Border Grid.Row="4" CornerRadius="6" Background="#14181F" ClipToBounds="True">
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent" Padding="2">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="6,4" />
                  <Setter Property="CornerRadius" Value="5" />
                  <Setter Property="Margin" Value="0,1" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PetRow">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="36" Height="36" CornerRadius="6" Background="#22000000" ClipToBounds="True" Margin="0,0,8,0">
                      <Image Source="{Binding Icon}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Species}" Foreground="{Binding SpeciesBrush}" FontSize="10.5" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding LevelText}" Foreground="{Binding LevelBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </Border>

      <!-- Gewähltes Pet und Karte -->
      <Border Grid.Column="1" Classes="card" Padding="12">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <Border Width="64" Height="64" CornerRadius="8" Background="#22000000" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Top">
              <Image Source="{Binding DetailIcon}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="{Binding DetailTitle}" Classes="h2" />
              <TextBlock Text="{Binding DetailLevel}" Foreground="#E0A84A" FontSize="12" />
              <TextBlock Text="{Binding DetailRegions}" Classes="dim" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding DetailRegions}"
                         IsVisible="{Binding DetailRegions, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Grid>

          <!-- Monster, die die Seele droppen -->
          <!-- alle Monster sichtbar (kein verstecktes Scrollen), dafür kompakt -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Monsters}" ToolTip.Tip="{l:T pets.monsters}" Margin="0,0,0,3">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PetMonsterRow">
                <Border Classes="chip" ToolTip.Tip="{Binding Count}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Name}" FontSize="10.5" />
                    <TextBlock Text="{Binding Number}" Foreground="#E0A84A" FontSize="10" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="2" CornerRadius="6" ClipToBounds="True" BorderBrush="#232A36" BorderThickness="1" MinHeight="220">
            <Panel>
              <views:PetMapView Name="FinderMap" AutoFit="False" DotBrush="{Binding DotBrush}" Map="{Binding Map}" Spawns="{Binding Spawns}" Self="{Binding Self}" />
              <Button Click="OnCenter" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="8,6"
                      Background="#CC141820" ToolTip.Tip="{l:T radar.center}"><Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon center, Size=16}" Width="16" Height="16" /></Button>
            </Panel>
          </Border>

          <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" Margin="2,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0">
              <Ellipse Width="9" Height="9" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{l:T pets.legend_spawn}" Classes="dim" FontSize="11" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,14,0">
              <Ellipse Width="10" Height="10" Fill="White" Stroke="#1E6FD9" StrokeThickness="2.5" VerticalAlignment="Center" />
              <TextBlock Text="{Binding PositionText}" Classes="dim" FontSize="11" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{l:T pets.map_hint}" Classes="dim" FontSize="10.5" HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{l:T pets.source}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
