<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherDPS.App.ViewModels"
             xmlns:views="using:AetherDPS.App.Views"
             xmlns:l="using:AetherDPS.App.Services"
             x:Class="AetherDPS.App.Views.PetsView"
             x:DataType="vm:PetsViewModel">

  <!-- Welt › Pets: links Filter und Liste auf dem Rahmen, rechts das gewählte Pet mit großem
       Fortschritt („12/25“, Balken, wie viele Seelen noch fehlen) und die Karte als Mulde. -->
  <Grid ColumnDefinitions="300,*" Margin="0,0,0,0">

    <!-- ── Liste ───────────────────────────────────────────────── -->
    <Border BorderBrush="{DynamicResource Line.Frame}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20,10,14,16">
        <StackPanel Spacing="6" Margin="0,0,0,8">
          <ListBox Classes="seg" ItemsSource="{Binding MapOptions}" SelectedItem="{Binding SelectedMap}" IsVisible="{Binding HasMapChoice}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PetMapOption">
                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ListBox Classes="seg" ItemsSource="{Binding SpeciesOptions}" SelectedItem="{Binding SelectedSpecies}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SpeciesOption">
                <Panel ToolTip.Tip="{Binding Name}" Height="30">
                  <TextBlock Text="{l:T pets.filter_short.all}" FontSize="13" IsVisible="{Binding IsAll}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  <Border Width="30" Height="30" CornerRadius="15" ClipToBounds="True" BorderBrush="{Binding Brush}" BorderThickness="2"
                          IsVisible="{Binding !IsAll}" Background="{DynamicResource Surface.WellDeep}">
                    <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                  </Border>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ListBox Classes="seg" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PetFilterOption">
                <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <TextBox Grid.Row="1" Text="{Binding Search}" Watermark="{l:T pets.search}" Margin="0,0,0,8" />
        <StackPanel Grid.Row="2" Spacing="2" Margin="2,0,0,8">
          <TextBlock Classes="small muted" Text="{Binding Summary}" TextWrapping="Wrap" />
          <TextBlock Classes="small warnline" Text="{Binding LevelsHint}" TextWrapping="Wrap"
                     IsVisible="{Binding LevelsHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <ListBox Grid.Row="3" Classes="plain" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PetRow">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,4">
                <Border Width="38" Height="38" CornerRadius="{DynamicResource Radius.Control}" Background="{DynamicResource Surface.WellDeep}" ClipToBounds="True" Margin="0,0,10,0">
                  <Image Source="{Binding Icon}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="small" Text="{Binding Species}" Foreground="{Binding SpeciesBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="small num" Text="{Binding LevelText}" Foreground="{Binding LevelBrush}" VerticalAlignment="Center" Margin="8,0,4,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- ── Gewähltes Pet und Karte ────────────────────────────── -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="28,10,32,16">
      <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasDetail}" Margin="0,0,0,12">
        <Border Width="84" Height="84" CornerRadius="{DynamicResource Radius.Well}" Background="{DynamicResource Surface.WellDeep}" ClipToBounds="True" Margin="0,0,16,0">
          <Image Source="{Binding DetailIcon}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="title" Text="{Binding DetailName}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding DetailSpecies}" Foreground="{Binding DotBrush}" FontWeight="Medium" />
          <TextBlock Classes="small muted" Text="{Binding DetailRegions}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding DetailRegions}" Margin="0,2,0,0"
                     IsVisible="{Binding DetailRegions, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <!-- Fortschritt groß -->
        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" MinWidth="220" Margin="20,0,0,0">
          <TextBlock Classes="display" Text="{Binding DetailReading}" HorizontalAlignment="Right" />
          <TextBlock Classes="small secondary" Text="{Binding DetailCaption}" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
          <ProgressBar Classes="fill" Value="{Binding DetailPercent}" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>

      <!-- Monster, die die Seele droppen -->
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Monsters}" ToolTip.Tip="{l:T pets.monsters}" Margin="0,0,0,10">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PetMonsterRow">
            <Border Classes="chip" ToolTip.Tip="{Binding Count}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="small" Text="{Binding Name}" />
                <TextBlock Classes="small muted" Text="{Binding Number}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Grid.Row="2" Classes="well" Padding="0" ClipToBounds="True" MinHeight="240">
        <Panel>
          <views:PetMapView Name="FinderMap" AutoFit="False" DotBrush="{Binding DotBrush}" Map="{Binding Map}" Spawns="{Binding Spawns}" Self="{Binding Self}" />
          <Button Classes="quiet" Click="OnCenter" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="8,6" ToolTip.Tip="{l:T radar.center}">
            <Image Source="{l:Icon center, Size=16}" Width="16" Height="16" />
          </Button>
        </Panel>
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" Margin="2,10,0,0">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
          <Ellipse Width="9" Height="9" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="small muted" Text="{l:T pets.legend_spawn}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
          <Ellipse Width="10" Height="10" Fill="{DynamicResource Text.Primary}" Stroke="{DynamicResource Accent.Phase}" StrokeThickness="2.5" VerticalAlignment="Center" />
          <TextBlock Classes="small muted" Text="{Binding PositionText}" />
        </StackPanel>
        <!-- Pet-Radar im Spiel -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" ToolTip.Tip="{l:T radar.enable_hint}">
          <Image Source="{l:Icon radar, Size=16}" Width="16" Height="16" VerticalAlignment="Center" />
          <TextBlock Classes="small secondary" Text="{l:T radar.settings_title}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding RadarModes}" SelectedItem="{Binding SelectedRadarMode}" MinWidth="200" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Mark}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="TextBlock.warnline">
      <Setter Property="Foreground" Value="{DynamicResource Signal.Warn}" />
    </Style>
  </UserControl.Styles>
</UserControl>
