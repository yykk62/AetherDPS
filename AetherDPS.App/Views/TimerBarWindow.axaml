<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherDPS.App.ViewModels"
        xmlns:l="using:AetherDPS.App.Services"
        x:Class="AetherDPS.App.Views.TimerBarWindow"
        x:DataType="vm:TimerRow"
        Title="{l:T timer_overlay.title}"
        SizeToContent="WidthAndHeight"
        SystemDecorations="None" Topmost="True" CanResize="False" ShowActivated="False" ShowInTaskbar="False"
        TransparencyLevelHint="Transparent" Background="Transparent" Icon="/Assets/icon.ico">

  <!-- Ein einzelner Timer als Kachel: ziehen = verschieben, auf die Gruppe ziehen oder Rechtsklick = zurück in die Gruppe -->
  <Border Name="Root" Background="#E6141820" CornerRadius="6" BorderBrush="#2A3240" BorderThickness="1"
          Padding="9,5,9,6" Width="146" Cursor="SizeAll">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="{l:T timer_overlay.attach}" Command="{Binding AttachCommand}" />
        <MenuItem Header="{l:T timer_overlay.edit}" Click="OnEditClicked" />
      </ContextMenu>
    </Border.ContextMenu>
    <StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="{Binding Icon}" Foreground="#E0A84A" FontSize="10" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Name}" Foreground="#8E96A3" FontSize="10.5" FontWeight="SemiBold" MaxWidth="106" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Text="{Binding Remaining}" FontSize="16" FontWeight="Bold"
                 Foreground="{Binding IsSoon, Converter={x:Static l:BoolBrush.DueGreenElseText}}" />
    </StackPanel>
  </Border>
</Window>
