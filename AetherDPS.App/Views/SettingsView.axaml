<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherDPS.App.ViewModels"
        xmlns:l="using:AetherDPS.App.Services"
        x:Class="AetherDPS.App.Views.SettingsView"
        x:DataType="vm:SettingsViewModel">

  <!-- Einstellungen im Blatt: Bereiche oben wählen, darunter Abschnitte auf dem Rahmen.
       Farben nur aus den Tokens (docs/DESIGN.md). -->
  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
      <Setter Property="FontSize" Value="{DynamicResource Size.Small}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <!-- Erklärung unter einer Checkbox, eingerückt auf Höhe des Texts -->
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
      <Setter Property="FontSize" Value="{DynamicResource Size.Small}" />
      <Setter Property="Margin" Value="28,0,0,0" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource Signal.Warn}" />
    </Style>
  </UserControl.Styles>

  <!-- Bereiche oben wählen, darunter nur die Karten des Bereichs -->
  <Grid RowDefinitions="Auto,*">
    <ListBox Name="SettingsNav" Classes="seg" SelectedIndex="0" Margin="0,0,0,6">
      <ListBoxItem Content="{l:T settings.nav.general}" />
      <ListBoxItem Content="{l:T settings.section.controls}" />
      <ListBoxItem Content="{l:T settings.nav.meter}" />
      <ListBoxItem Content="{l:T settings.nav.privacy}" />
    </ListBox>

    <StackPanel Grid.Row="1" Spacing="14" IsVisible="{Binding #SettingsNav.SelectedIndex, Converter={x:Static l:TabIs.Instance}, ConverterParameter=0}">
    <Border Classes="card">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon globe, Size=18}" Width="18" Height="18" />
          <TextBlock Classes="section" Text="{l:T settings.section.language}" VerticalAlignment="Center" />
        </StackPanel>
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" MinWidth="240" />
        <TextBlock Classes="dim" Text="{l:T settings.language_hint}" />
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding LanguageChanged}">
          <TextBlock Text="{l:T settings.language_restart_hint}" Classes="warn" VerticalAlignment="Center" />
          <Button Classes="primary" Content="{l:T settings.language_restart}" Command="{Binding RestartCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon play, Size=18}" Width="18" Height="18" />
          <TextBlock Classes="section" Text="{l:T settings.section.start}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding LaunchGameWithMeter}">
            <TextBlock Classes="label" Text="{l:T settings.launch_game}" />
          </CheckBox>
          <TextBlock Classes="hint" Text="{l:T settings.launch_game_hint}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="9">
          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon refresh, Size=18}" Width="18" Height="18" />
          <TextBlock Classes="section" Text="{l:T update.heading}" VerticalAlignment="Center" />
        </StackPanel>
          <TextBlock Grid.Column="1" Classes="dim" Text="{Binding VersionText}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding AutoUpdate}" IsEnabled="{Binding CanSelfUpdate}">
            <TextBlock Classes="label" Text="{l:T update.auto}" />
          </CheckBox>
          <TextBlock Classes="hint" Text="{l:T update.auto_hint}" />
        </StackPanel>
        <WrapPanel>
          <Button Content="{l:T update.check}" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding CanSelfUpdate}" Margin="0,0,8,6" />
          <Button Classes="primary" Content="{l:T update.restart}" Command="{Binding RestartForUpdateCommand}" IsVisible="{Binding UpdateReady}" Margin="0,0,8,6" />
          <Button Content="{l:T update.releases}" Command="{Binding OpenReleasesCommand}" Margin="0,0,8,6" />
        </WrapPanel>
        <TextBlock Classes="dim" Text="{Binding UpdateStatus}"
                   IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="14" IsVisible="{Binding #SettingsNav.SelectedIndex, Converter={x:Static l:TabIs.Instance}, ConverterParameter=1}">
    <Border Classes="card">
      <StackPanel Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon keyboard, Size=18}" Width="18" Height="18" />
          <TextBlock Classes="section" Text="{l:T settings.section.controls}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="{l:T settings.hotkey}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Name="HotkeyBox" Text="{Binding HotkeyText}" IsReadOnly="True" FontSize="14" FontWeight="SemiBold"
                     HorizontalContentAlignment="Center" Cursor="Hand" />
            <Button Grid.Column="1" Content="{l:T settings.hotkey_reset}" Command="{Binding ResetHotkeyCommand}" Margin="8,0,0,0" MinWidth="160" HorizontalContentAlignment="Center" />
          </Grid>
          <TextBlock Classes="dim" Text="{Binding HotkeyError}" Foreground="{DynamicResource Signal.Bad}"
                     IsVisible="{Binding HotkeyError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="dim" Text="{l:T settings.hotkey_hint}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <CheckBox IsChecked="{Binding ScreenshotEnabled}">
            <TextBlock Classes="label" Text="{l:T settings.screenshot}" />
          </CheckBox>
          <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ScreenshotEnabled}">
            <TextBox Name="ScreenshotBox" Text="{Binding ScreenshotText}" IsReadOnly="True" FontSize="14" FontWeight="SemiBold"
                     HorizontalContentAlignment="Center" Cursor="Hand" />
            <Button Grid.Column="1" Content="{l:T settings.screenshot_reset}" Command="{Binding ResetScreenshotHotkeyCommand}" Margin="8,0,0,0" MinWidth="160" HorizontalContentAlignment="Center" />
          </Grid>
          <TextBlock Classes="dim" Text="{l:T settings.screenshot_hint}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="{l:T settings.placement}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Name="PlacementBox" Text="{Binding PlacementText}" IsReadOnly="True" FontSize="14" FontWeight="SemiBold"
                     HorizontalContentAlignment="Center" Cursor="Hand" />
            <Button Grid.Column="1" Content="{l:T settings.placement_reset}" Command="{Binding ResetPlacementHotkeyCommand}" Margin="8,0,0,0" MinWidth="160" HorizontalContentAlignment="Center" />
          </Grid>
          <TextBlock Classes="dim" Text="{l:T settings.placement_hint}" />
          <Button Content="{l:T settings.placement_now}" Command="{Binding PlaceOverlaysCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </StackPanel>
    </Border>
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="14" IsVisible="{Binding #SettingsNav.SelectedIndex, Converter={x:Static l:TabIs.Instance}, ConverterParameter=2}">
    <Border Classes="card">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon eye, Size=18}" Width="18" Height="18" />
          <TextBlock Classes="section" Text="{l:T settings.section.tracking}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding AutoTrack}">
            <TextBlock Classes="label" Text="{l:T settings.auto_track}" />
          </CheckBox>
          <TextBlock Classes="hint" Text="{l:T settings.auto_track_hint}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding PartyOnly}">
            <TextBlock Classes="label" Text="{l:T settings.party_only}" />
          </CheckBox>
          <TextBlock Classes="hint" Text="{l:T settings.party_only_hint}" />
        </StackPanel>
        <CheckBox IsChecked="{Binding HideName}">
          <TextBlock Classes="label" Text="{l:T settings.hide_name}" />
        </CheckBox>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon monitor, Size=18}" Width="18" Height="18" />
          <TextBlock Classes="section" Text="{l:T settings.section.display}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{l:T settings.opacity}" />
            <TextBlock Grid.Column="1" Text="{Binding OpacityPercent, StringFormat='{}{0:0} %'}" />
          </Grid>
          <Slider Minimum="20" Maximum="100" Value="{Binding OpacityPercent}" TickFrequency="5" IsSnapToTickEnabled="True" />
        </StackPanel>
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding CombatHints}">
            <TextBlock Classes="label" Text="{l:T settings.combat_hints}" />
          </CheckBox>
          <TextBlock Classes="hint" Text="{l:T settings.combat_hints_hint}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding StaggerWarning}">
            <TextBlock Classes="label" Text="{l:T settings.stagger_warning}" />
          </CheckBox>
          <TextBlock Classes="hint" Text="{l:T settings.stagger_warning_hint}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding OverlaysBySituation}">
            <TextBlock Classes="label" Text="{l:T settings.by_situation}" />
          </CheckBox>
          <TextBlock Classes="hint" Text="{l:T settings.by_situation_hint}" />
        </StackPanel>
      </StackPanel>
    </Border>
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="14" IsVisible="{Binding #SettingsNav.SelectedIndex, Converter={x:Static l:TabIs.Instance}, ConverterParameter=3}">
    <Border Classes="card">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon chat, Size=18}" Width="18" Height="18" />
          <TextBlock Classes="section" Text="{l:T settings.section.discord}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="label" Text="{l:T settings.webhook}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding DiscordWebhook}" Watermark="https://discord.com/api/webhooks/…" />
          <Button Grid.Column="1" Content="{l:T settings.webhook_test}" Command="{Binding TestWebhookCommand}" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Classes="dim" Text="{Binding WebhookStatus}" IsVisible="{Binding WebhookStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="dim" Text="{l:T settings.webhook_hint}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon shield-check, Size=18}" Width="18" Height="18" />
          <TextBlock Classes="section" Text="{l:T settings.section.privacy}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding UsageStats}">
            <TextBlock Classes="label" Text="{l:T settings.usage_stats}" />
          </CheckBox>
          <TextBlock Classes="hint" Text="{l:T settings.usage_stats_hint}" />
          <Border Background="{DynamicResource Surface.WellDeep}" CornerRadius="{DynamicResource Radius.Control}" Padding="10,6" Margin="28,4,0,0">
            <SelectableTextBlock Text="{Binding UsageStatsExample}" FontFamily="Consolas,monospace" FontSize="11" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding DiscordPresence}">
            <TextBlock Classes="label" Text="{l:T settings.discord_presence}" />
          </CheckBox>
          <TextBlock Classes="hint" Text="{l:T settings.discord_presence_hint}" />
          <CheckBox IsChecked="{Binding DiscordPresenceNames}" IsEnabled="{Binding DiscordPresence}" Margin="28,2,0,0">
            <TextBlock Classes="label" Text="{l:T settings.discord_presence_names}" />
          </CheckBox>
          <TextBlock Classes="dim" Text="{Binding PresenceStatus}" Margin="28,0,0,0"
                     IsVisible="{Binding PresenceStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding ProfileHistory}">
            <TextBlock Classes="label" Text="{l:T settings.profile_history}" />
          </CheckBox>
          <TextBlock Classes="hint" Text="{l:T settings.profile_history_hint}" />
        </StackPanel>
        <TextBlock Classes="dim" Text="{l:T settings.privacy_hint}" />
      </StackPanel>
    </Border>
    </StackPanel>
  </Grid>
</UserControl>
