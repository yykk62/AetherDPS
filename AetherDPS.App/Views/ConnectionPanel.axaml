<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherDPS.App.ViewModels"
             xmlns:views="using:AetherDPS.App.Views"
             xmlns:l="using:AetherDPS.App.Services"
             x:Class="AetherDPS.App.Views.ConnectionPanel"
             x:DataType="vm:HubViewModel">

  <!-- Verbindung (klappt unter dem Statusfeld auf): aktueller Ping groß, der Rest als Satz,
       Verlauf als Kurve in der Mulde, darunter die Prüfung mit Urteil. -->
  <StackPanel Spacing="14" Margin="22,18,22,20">
    <Grid ColumnDefinitions="Auto,*">
      <StackPanel Spacing="0">
        <TextBlock Classes="small muted" Text="{l:T conn.graph}" />
        <TextBlock Classes="reading" Text="{Binding PingNow}" />
      </StackPanel>
      <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding PingSummary}" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="20,0,0,6" />
    </Grid>

    <Border Classes="well" Padding="12,10">
      <Panel Height="150">
        <views:PingGraph Samples="{Binding PingSamples}" SpikeThreshold="{Binding SpikeThreshold}" />
        <TextBlock Classes="muted" Text="{l:T conn.no_data}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasPingData}" TextWrapping="Wrap" />
      </Panel>
    </Border>
    <TextBlock Classes="small muted" Text="{Binding ServerText}" IsVisible="{Binding ServerText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Border Classes="framerule" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="section" Text="{l:T conn.check}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="quiet" Content="{l:T conn.check}" Command="{Binding DiagnoseCommand}" IsEnabled="{Binding !IsDiagnosing}" />
    </Grid>
    <ItemsControl ItemsSource="{Binding DiagnosisRows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DiagnosisRow">
          <Grid ColumnDefinitions="22,150,*" Margin="0,4">
            <Image Source="{Binding Ok, Converter={x:Static views:ConnectionPanel.OkIcon}}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="Medium" />
            <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Result}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding DiagnosisText}" TextWrapping="Wrap" IsVisible="{Binding DiagnosisText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Classes="small muted" Text="{l:T conn.note}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
