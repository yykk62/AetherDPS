<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherDPS.App.ViewModels"
             xmlns:l="using:AetherDPS.App.Services"
             x:Class="AetherDPS.App.Views.TimersView"
             x:DataType="vm:TimersViewModel">

  <!-- Welt › Timer: links was als Nächstes kommt (Mulde) und die Feldbosse je Karte,
       rechts auf dem Rahmen eigene Timer, feste Termine und die Overlay-Einstellungen. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid ColumnDefinitions="*,36,300" Margin="32,10,32,28">

      <StackPanel Spacing="22">
        <!-- Alle Timer: das Instrument dieses Bereichs -->
        <Border Classes="well" Padding="8,12,8,8">
          <StackPanel Spacing="2">
            <TextBlock Classes="section" Text="{l:T timers.title}" Margin="12,0,12,6" />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TimerRow">
                  <Border Classes="timerrow" Classes.soon="{Binding IsSoon}" Classes.due="{Binding IsDue}">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="28,*,Auto,Auto,Auto">
                        <Image Source="{Binding Icon, Converter={x:Static l:Icons.ByName}}" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="small muted" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                          <!-- Countdown-Spur: füllt sich in der letzten Stunde -->
                          <ProgressBar Classes="trace" Value="{Binding Urgency}" IsVisible="{Binding HasUrgency}" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Text.Secondary}" Classes.soon="{Binding IsSoon}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="muted num" Text="{Binding At}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Grid.Column="3" Classes="num countdown" Text="{Binding Remaining}" VerticalAlignment="Center" MinWidth="96" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,0">
                          <Button Classes="icon" Command="{Binding StartCommand}" IsVisible="{Binding IsCustom}" ToolTip.Tip="{l:T timers.start}">
                            <Image Source="{l:Icon play, Size=14}" Width="14" Height="14" />
                          </Button>
                          <Button Classes="icon" Command="{Binding RemoveCommand}" IsVisible="{Binding IsCustom}" ToolTip.Tip="{l:T timers.remove}">
                            <Image Source="{l:Icon close, Size=12}" Width="12" Height="12" />
                          </Button>
                          <Button Classes="icon" Command="{Binding RemoveCommand}" IsVisible="{Binding IsBoss}" ToolTip.Tip="{l:T timers.remove}">
                            <Image Source="{l:Icon close, Size=12}" Width="12" Height="12" />
                          </Button>
                        </StackPanel>
                      </Grid>
                      <!-- Unbekannter Boss: einmal Respawn eintragen oder ignorieren -->
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NeedsRespawn}" Margin="28,0,0,2">
                        <TextBlock Classes="small secondary" Text="{l:T timers.respawn}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding RespawnMinutes}" Width="70" Watermark="{l:T timers.minutes_watermark}" />
                        <Button Classes="quiet" Content="{l:T timers.save}" Command="{Binding SaveRespawnCommand}" />
                        <Button Classes="icon" Padding="10,6" Command="{Binding IgnoreCommand}" ToolTip.Tip="{l:T timers.ignore_hint}">
                          <TextBlock Classes="small secondary" Text="{l:T timers.ignore}" />
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="small muted" Text="{l:T timers.boss_note_short}" TextWrapping="Wrap" Margin="12,8,12,2" />
          </StackPanel>
        </Border>

        <!-- Feldbosse je Karte -->
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="{l:T fb.title}" />
          <TextBlock Classes="small muted" Text="{l:T fb.hint_short}" TextWrapping="Wrap" />
          <TextBlock Classes="warnline" Text="{l:T fb.open_map}" IsVisible="{Binding !FieldBossesKnown}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <ItemsControl ItemsSource="{Binding FieldBossGroups}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FieldBossGroup">
                <StackPanel>
                  <Border Classes="framerule" />
                  <Expander Classes="map" Header="{Binding Name}" IsExpanded="{Binding Expanded}" HorizontalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,0,8">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldBossRow">
                          <Grid ColumnDefinitions="32,*,Auto,Auto" MinHeight="32">
                            <Button Classes="icon" Padding="5" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="{l:T fb.star_tip}">
                              <Image Source="{Binding IsFavorite, Converter={x:Static l:Icons.StarFilledElseOutline}}" Width="16" Height="16" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />
                            <TextBlock Grid.Column="2" Classes="small muted num" Text="{Binding At}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="3" Classes="num fbstate" Classes.up="{Binding IsUp}" Classes.estimate="{Binding IsEstimated}"
                                       Text="{Binding State}" MinWidth="120" VerticalAlignment="Center" Margin="12,0,4,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <!-- ── rechts: anlegen, Termine, Overlay ───────────────── -->
      <StackPanel Grid.Column="2" Spacing="24">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{l:T timers.custom}" />
          <TextBox Text="{Binding NewName}" Watermark="{l:T timers.custom_name}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding NewMinutes}" Width="80" Watermark="{l:T timers.minutes_watermark}" />
            <Button Classes="quiet" Content="{l:T timers.add}" Command="{Binding AddCustomCommand}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="{l:T timers.schedules_short}" />
          <ItemsControl ItemsSource="{Binding Schedules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScheduleToggle">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Top">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" />
                        <TextBlock Classes="small muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </CheckBox>
                    <ToggleButton Grid.Column="1" Classes="bell" IsChecked="{Binding Reminder}" IsEnabled="{Binding Enabled}" ToolTip.Tip="{l:T timers.remind}" VerticalAlignment="Top">
                      <Image Source="{l:Icon bell, Size=16}" Width="16" Height="16" />
                    </ToggleButton>
                  </Grid>
                  <Border Classes="framerule" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="{l:T timers.overlay_title}" />
          <ComboBox ItemsSource="{Binding OverlayModes}" SelectedItem="{Binding SelectedOverlayMode}" HorizontalAlignment="Stretch" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSoonMode}">
            <TextBox Text="{Binding SoonMinutes}" Width="56" />
            <TextBlock Classes="secondary" Text="{l:T timers.overlay_soon_minutes}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding ReminderMinutes}" Width="56" />
            <TextBlock Classes="secondary" Text="{l:T timers.reminder_short}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Classes="icon" Padding="10,6" Command="{Binding SaveReminderCommand}">
              <TextBlock Classes="small" Text="{l:T timers.save}" />
            </Button>
          </StackPanel>
          <CheckBox IsChecked="{Binding OverlayLocked}">
            <TextBlock Text="{l:T timers.overlay_locked}" TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock Classes="small muted" Text="{l:T timers.overlay_hint_short}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>

  <UserControl.Styles>
    <Style Selector="Border.timerrow">
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="Border.timerrow.soon">
      <Setter Property="Background" Value="{DynamicResource Surface.NoticeWarn}" />
    </Style>
    <Style Selector="TextBlock.countdown">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.timerrow.soon TextBlock.countdown">
      <Setter Property="Foreground" Value="{DynamicResource Signal.Warn}" />
    </Style>
    <Style Selector="Border.timerrow.due TextBlock.countdown">
      <Setter Property="Foreground" Value="{DynamicResource Signal.Good}" />
    </Style>
    <Style Selector="ProgressBar.trace.soon">
      <Setter Property="Foreground" Value="{DynamicResource Signal.Warn}" />
    </Style>
    <Style Selector="TextBlock.fbstate">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.fbstate.up">
      <Setter Property="Foreground" Value="{DynamicResource Signal.Good}" />
    </Style>
    <Style Selector="TextBlock.warnline">
      <Setter Property="Foreground" Value="{DynamicResource Signal.Warn}" />
    </Style>
  </UserControl.Styles>
</UserControl>
