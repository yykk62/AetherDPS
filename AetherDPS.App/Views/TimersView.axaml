<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherDPS.App.ViewModels"
             xmlns:l="using:AetherDPS.App.Services"
             x:Class="AetherDPS.App.Views.TimersView"
             x:DataType="vm:TimersViewModel">
  <UserControl.Styles>
    <Style Selector="CheckBox.day">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" Margin="12,4,22,22">

      <!-- Overlay und Erinnerungen -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{l:T timers.overlay_title}" />
          <WrapPanel>
            <TextBlock Text="{l:T timers.overlay_mode}" VerticalAlignment="Center" Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding OverlayModes}" SelectedItem="{Binding SelectedOverlayMode}" MinWidth="220" Margin="0,0,14,6" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSoonMode}" Margin="0,0,0,6">
              <TextBox Text="{Binding SoonMinutes}" Width="50" />
              <TextBlock Text="{l:T timers.overlay_soon_minutes}" VerticalAlignment="Center" />
            </StackPanel>
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{l:T timers.reminder_minutes}" VerticalAlignment="Center" />
            <TextBox Text="{Binding ReminderMinutes}" Width="50" />
            <Button Classes="secondary" Content="{l:T timers.save}" Command="{Binding SaveReminderCommand}" />
          </StackPanel>
          <CheckBox IsChecked="{Binding OverlayLocked}" Content="{l:T timers.overlay_locked}" />
          <TextBlock Text="{l:T timers.overlay_hint}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Alle Timer -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{l:T timers.title}" />
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TimerRow">
                <Border CornerRadius="4" Background="#14FFFFFF" Padding="10,6" Margin="0,0,0,4">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="26,*,Auto,Auto,Auto">
                      <TextBlock Text="{Binding Icon}" FontSize="15" Foreground="#E0A84A" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Classes="dim" FontSize="11" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding At}" Classes="dim" VerticalAlignment="Center" Margin="12,0,0,0" />
                      <TextBlock Grid.Column="3" Text="{Binding Remaining}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"
                                 Foreground="{Binding IsDue, Converter={x:Static l:BoolBrush.DueGreenElseText}}" />
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="secondary" Content="{l:T timers.start}" Command="{Binding StartCommand}" IsVisible="{Binding IsCustom}" />
                        <Button Classes="secondary" Content="✕" Command="{Binding RemoveCommand}" IsVisible="{Binding IsCustom}" ToolTip.Tip="{l:T timers.remove}" />
                        <Button Classes="secondary" Content="✕" Command="{Binding RemoveCommand}" IsVisible="{Binding IsBoss}" ToolTip.Tip="{l:T timers.remove}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding NeedsRespawn}" Margin="26,0,0,0">
                      <TextBlock Text="{l:T timers.respawn}" Classes="dim" VerticalAlignment="Center" FontSize="12" />
                      <TextBox Text="{Binding RespawnMinutes}" Width="70" Watermark="Min." />
                      <Button Classes="secondary" Content="{l:T timers.save}" Command="{Binding SaveRespawnCommand}" />
                      <Button Classes="secondary" Content="{l:T timers.ignore}" Command="{Binding IgnoreCommand}" ToolTip.Tip="{l:T timers.ignore_hint}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{l:T timers.boss_note}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Feldbosse -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{l:T fb.title}" />
          <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Text="{l:T fb.hint}" />
          <TextBlock Foreground="#E0A84A" FontSize="12" TextWrapping="Wrap" Text="{l:T fb.open_map}" IsVisible="{Binding !FieldBossesKnown}" />
          <ItemsControl ItemsSource="{Binding FieldBossGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FieldBossGroup">
                <Expander Header="{Binding Name}" IsExpanded="{Binding Expanded}" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FieldBossRow">
                        <Grid ColumnDefinitions="30,*,Auto,Auto" Margin="0,1">
                          <Button Content="{Binding IsFavorite, Converter={x:Static l:BoolText.StarFilledElseEmpty}}" Command="{Binding ToggleFavoriteCommand}"
                                  Background="Transparent" Foreground="#E0A84A" Padding="2,0" FontSize="15" ToolTip.Tip="{l:T fb.star_tip}" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding At}" Classes="dim" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                          <TextBlock Grid.Column="3" Text="{Binding State}" MinWidth="110" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                                     Foreground="{Binding IsUp, Converter={x:Static l:BoolBrush.DueGreenElseText}}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Feste Termine -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{l:T timers.schedules}" />
          <TextBlock Text="{l:T timers.schedules_hint}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Schedules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScheduleToggle">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <CheckBox IsChecked="{Binding Enabled}">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Classes="dim" FontSize="11" />
                    </StackPanel>
                  </CheckBox>
                  <CheckBox Grid.Column="1" IsChecked="{Binding Reminder}" Content="{l:T timers.remind}" IsEnabled="{Binding Enabled}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Eigener Countdown -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{l:T timers.custom}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox Text="{Binding NewName}" Width="220" Watermark="{l:T timers.custom_name}" />
            <TextBox Text="{Binding NewMinutes}" Width="80" Watermark="Min." />
            <Button Classes="primary" Content="{l:T timers.add}" Command="{Binding AddCustomCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
