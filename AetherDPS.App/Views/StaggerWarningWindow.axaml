<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherDPS.App.ViewModels"
        xmlns:l="using:AetherDPS.App.Services"
        x:Class="AetherDPS.App.Views.StaggerWarningWindow"
        x:DataType="vm:StaggerWarningViewModel"
        Title="{l:T warning.title}"
        SizeToContent="WidthAndHeight"
        SystemDecorations="None" Topmost="True" CanResize="False" ShowActivated="False" ShowInTaskbar="False"
        TransparencyLevelHint="Transparent" Background="Transparent" Icon="/Assets/icon.ico">

  <!-- Mitten im Bild, halbtransparent, Klicks gehen immer ins Spiel -->
  <Border Background="#99141820" CornerRadius="10" Padding="22,12" Width="460">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{l:T warning.title}" Foreground="#C9A8F2" FontSize="13" FontWeight="Bold" LetterSpacing="2" />
          <TextBlock Text="{Binding Boss}" Foreground="#EEF0F3" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding TimeLeft}" FontSize="38" FontWeight="Bold" VerticalAlignment="Center"
                   Foreground="{Binding Hurry, Converter={x:Static l:BoolBrush.HurryRedElseText}}">
          <TextBlock.Effect>
            <DropShadowEffect BlurRadius="4" OffsetX="0" OffsetY="1" Color="#C0000000" />
          </TextBlock.Effect>
        </TextBlock>
      </Grid>
      <ProgressBar Height="16" MinHeight="0" CornerRadius="8" Maximum="100" Value="{Binding Percent}"
                   Foreground="#A970E8" Background="#33FFFFFF" />
      <TextBlock Text="{Binding Points}" Foreground="#C9A8F2" FontSize="12" HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</Window>
