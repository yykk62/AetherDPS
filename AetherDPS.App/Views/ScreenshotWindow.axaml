<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:AetherDPS.App.Services"
        x:Class="AetherDPS.App.Views.ScreenshotWindow"
        Title="{l:T shot.title}"
        SystemDecorations="None" ShowActivated="False" Topmost="True" ShowInTaskbar="False"
        CanResize="False" Background="Black" Icon="/Assets/icon.ico"
        ToolTip.Tip="{l:T shot.hint}">
  <Image Name="Picture" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
</Window>
