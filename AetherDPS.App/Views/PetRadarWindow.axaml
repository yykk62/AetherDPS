<Window Classes="ins" FontFamily="{DynamicResource Font.Ui}" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherDPS.App.ViewModels"
        xmlns:views="using:AetherDPS.App.Views"
        xmlns:l="using:AetherDPS.App.Services"
        x:Class="AetherDPS.App.Views.PetRadarWindow"
        x:DataType="vm:PetRadarViewModel"
        Title="{l:T radar.title}"
        SystemDecorations="None" ShowActivated="False" Topmost="True" ShowInTaskbar="False"
        CanResize="False" Width="290" SizeToContent="Height"
        TransparencyLevelHint="Transparent" Background="Transparent">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style Selector="Button.row">
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <!-- kleine Knöpfe auf der Karte -->
    <Style Selector="Button.ov">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Surface.WellDeep}" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style Selector="Border.ov">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="{DynamicResource Surface.WellDeep}" />
    </Style>
  </Window.Styles>
  <Border Name="Root" Background="{DynamicResource Surface.WellDeep}" BorderBrush="{DynamicResource Line.Frame}" BorderThickness="1" CornerRadius="8" Padding="5">
    <Panel>
      <!-- Eingeklappt: nur eine kleine Leiste. Klick klappt auf -->
      <StackPanel Name="MiniBar" Orientation="Horizontal" Spacing="6" IsVisible="False" Margin="2,0" ToolTip.Tip="{l:T radar.expand_tip}">
        <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon center, Size=14}" Width="14" Height="14" />
        <TextBlock Text="{l:T radar.title}" Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon chevron-right, Size=10}" Width="10" Height="10" Opacity="0.7" />
      </StackPanel>

      <StackPanel Name="Full" Spacing="6">
        <!-- Karte; alle Knöpfe liegen klein auf ihr: oben links Overlays platzieren, oben rechts einklappen/schließen,
             unten links Liste ein/aus, unten rechts zu dir -->
        <Border CornerRadius="6" ClipToBounds="True" Cursor="Hand">
          <Panel>
            <views:PetMapView Name="RadarMap" Height="230" Map="{Binding Map}" Spawns="{Binding Spawns}" Self="{Binding Self}"
                              SpawnBrushes="{Binding SpawnBrushes}" Minimap="True" MaxDot="4.5" ToolTip.Tip="{l:T radar.map_tip}" />
            <Border Name="MoveHandle" Classes="ov" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Cursor="Hand" ToolTip.Tip="{l:T radar.move_tip}">
              <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon drag, Size=12}" Width="12" Height="12" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
              <Button Classes="ov" Click="OnCollapse" ToolTip.Tip="{l:T radar.collapse_tip}"><Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon chevron-down, Size=11}" Width="11" Height="11" /></Button>
              <Button Classes="ov" Click="OnClose" ToolTip.Tip="{l:T radar.close_tip}"><Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon close, Size=11}" Width="11" Height="11" /></Button>
            </StackPanel>
            <Button Classes="ov" Click="OnToggleList" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5"
                    ToolTip.Tip="{l:T radar.list}"><Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon menu, Size=12}" Width="12" Height="12" /></Button>
            <Button Classes="ov" Click="OnCenter" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"
                    ToolTip.Tip="{l:T radar.center}"><Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon center, Size=13}" Width="13" Height="13" /></Button>
          </Panel>
        </Border>
        <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Text.Muted}" FontSize="11" TextWrapping="Wrap"
                   IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- Fehlende Pets: zu = ganz weg (☰ auf der Karte holt sie zurück) -->
        <ScrollViewer MaxHeight="190" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ListOpen}" Cursor="Arrow">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RadarRow">
                <Button Classes="row" Command="{Binding $parent[ItemsControl].((vm:PetRadarViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}"
                        Background="{Binding IsSelected, Converter={x:Static l:BoolBrush.SelectedRow}}" ToolTip.Tip="{l:T radar.row_tip}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Panel Margin="0,0,6,0" VerticalAlignment="Center">
                      <Border Width="30" Height="30" CornerRadius="5" Background="{DynamicResource Surface.WellDeep}" ClipToBounds="True">
                        <Image Source="{Binding Icon}" />
                      </Border>
                      <Ellipse Width="9" Height="9" Fill="{Binding Color}" Stroke="{DynamicResource Surface.WellDeep}" StrokeThickness="1.5" IsVisible="{Binding HasColor}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" />
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Monster}" FontSize="11" Foreground="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasMonster}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Level}" FontSize="11.5" Foreground="{DynamicResource Text.Muted}" Margin="6,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Distance}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>

      <!-- Größe ändern -->
      <Border Name="Grip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"
              Background="Transparent" Cursor="BottomRightCorner" ToolTip.Tip="{l:T radar.resize_tip}">
        <Path Data="M 12,2 L 2,12 M 12,6 L 6,12 M 12,10 L 10,12" Stroke="{DynamicResource Line.Tick}" StrokeThickness="1.2" />
      </Border>
    </Panel>
  </Border>
</Window>
