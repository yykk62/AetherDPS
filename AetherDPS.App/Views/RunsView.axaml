<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherDPS.App.ViewModels"
             xmlns:l="using:AetherDPS.App.Services"
             x:Class="AetherDPS.App.Views.RunsView"
             x:DataType="vm:RunsViewModel">
  <Grid ColumnDefinitions="250,*" Margin="12,4,22,22">
    <!-- Liste -->
    <Border Classes="card" Padding="6" Margin="0,0,12,0">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Classes="h2" Text="{l:T runs.list}" Margin="8,4,0,8" />
        <ListBox Grid.Row="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RunListItem">
              <StackPanel Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="🏆" IsVisible="{Binding IsBest}" FontSize="12" />
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Details -->
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">
        <TextBlock Text="{l:T runs.empty}" Classes="dim" IsVisible="{Binding !HasRun}" TextWrapping="Wrap" Margin="4" />

        <Border Classes="card" Name="DetailsCard" IsVisible="{Binding HasRun}" Background="#191E28">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding RunTitle}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RunSummary}" Classes="dim" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Comparison}" Foreground="#E0A84A" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding Comparison, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>

            <ListBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}" Background="Transparent" Padding="0">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,0,0,3" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlayerRow">
                  <Border Height="30" CornerRadius="4" Background="#14FFFFFF">
                    <Panel>
                      <ProgressBar Height="30" MinHeight="0" Maximum="100" Value="{Binding BarPercent}" Foreground="{Binding ClassBrush}"
                                   Background="Transparent" Opacity="0.35" CornerRadius="4" />
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="6,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Image Source="{Binding ClassIcon}" Width="22" Height="22" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding ClassName}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Dps}" FontWeight="SemiBold" MinWidth="70" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding Total}" Classes="dim" MinWidth="60" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding Share}" Classes="dim" MinWidth="56" TextAlignment="Right" />
                      </Grid>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ItemsControl ItemsSource="{Binding Bosses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BossRow">
                  <Grid ColumnDefinitions="22,*" Margin="2,3">
                    <TextBlock Text="✔" Foreground="#4CC36A" IsVisible="{Binding Killed}" ToolTip.Tip="{l:T runs.boss_killed}" />
                    <TextBlock Text="✘" Foreground="#E86A6A" IsVisible="{Binding !Killed}" ToolTip.Tip="{l:T runs.boss_not_killed}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" Classes="dim" FontSize="11" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasRun}">
          <Button Classes="primary" Content="{l:T runs.copy_image}" Command="{Binding CopyImageCommand}" />
          <Button Classes="secondary" Content="{l:T runs.copy_text}" Command="{Binding CopyTextCommand}" />
          <Button Classes="secondary" Content="{l:T runs.delete}" Command="{Binding DeleteRunCommand}" />
          <TextBlock Text="{Binding Notice}" Classes="dim" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>

        <!-- Kampfanalyse -->
        <Border Classes="card" IsVisible="{Binding HasPlayer}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{Binding PlayerTitle}" />
            <TextBlock Text="{Binding PlayerFacts}" Classes="dim" />
            <TextBlock Text="{l:T runs.skills}" FontWeight="SemiBold" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding Skills}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AnalysisRow">
                  <Panel Height="22" Margin="0,1">
                    <ProgressBar MinHeight="0" Height="22" Maximum="100" Value="{Binding BarPercent}" Foreground="#5B8DEF" Background="Transparent" Opacity="0.3" CornerRadius="3" />
                    <Grid ColumnDefinitions="*,Auto" Margin="8,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Classes="dim" Margin="8,0,0,0" />
                    </Grid>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{l:T runs.buffs}" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock Text="{l:T runs.buffs_empty}" Classes="dim" FontSize="12" IsVisible="{Binding !HasBuffs}" />
            <ItemsControl ItemsSource="{Binding Buffs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AnalysisRow">
                  <Panel Height="22" Margin="0,1">
                    <ProgressBar MinHeight="0" Height="22" Maximum="100" Value="{Binding BarPercent}" Foreground="#E0A84A" Background="Transparent" Opacity="0.3" CornerRadius="3" />
                    <Grid ColumnDefinitions="*,Auto" Margin="8,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Classes="dim" Margin="8,0,0,0" />
                    </Grid>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{l:T runs.analysis_note}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
