<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherDPS.App.ViewModels"
             xmlns:l="using:AetherDPS.App.Services"
             x:Class="AetherDPS.App.Views.PartyView"
             x:DataType="vm:PartyViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" Margin="12,4,22,22">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{l:T party.title}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="dim" FontSize="11" Text="{Binding Updated}" VerticalAlignment="Center" />
              <Button Classes="secondary" Content="{l:T armory.show_self}" Command="{Binding ShowSelfCommand}" IsVisible="{Binding CanShowSelf}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{l:T party.empty}" Classes="dim" IsVisible="{Binding !HasParty}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,140,70,120" IsVisible="{Binding HasParty}" Margin="6,0">
            <TextBlock Classes="dim" FontSize="11" Text="{l:T party.col.name}" />
            <TextBlock Grid.Column="1" Classes="dim" FontSize="11" Text="{l:T party.col.server}" />
            <TextBlock Grid.Column="2" Classes="dim" FontSize="11" Text="{l:T party.col.level}" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Classes="dim" FontSize="11" Text="{l:T party.col.power}" TextAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Members}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PartyRow">
                <Button Padding="0" Margin="0,0,0,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent"
                        Command="{Binding $parent[ItemsControl].((vm:PartyViewModel)DataContext).ShowMemberCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="{l:T armory.click_tip}">
                <Border Height="34" CornerRadius="4" Background="#14FFFFFF">
                  <Panel>
                    <ProgressBar Height="34" MinHeight="0" Maximum="100" Value="{Binding PowerPercent}" Foreground="{Binding ClassBrush}"
                                 Background="Transparent" Opacity="0.25" CornerRadius="4" />
                    <Grid ColumnDefinitions="*,140,70,120" Margin="6,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="{Binding ClassIcon}" Width="22" Height="22" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ClassName}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Server}" Classes="dim" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Level}" TextAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding CombatPower}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </Panel>
                </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{l:T party.note}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Profil von NCSOFT (auf Klick) -->
      <Border Classes="card" IsVisible="{Binding ProfileStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding ProfileTitle}" IsVisible="{Binding HasProfile}" />
          <TextBlock Text="{Binding ProfileFacts}" FontWeight="SemiBold" Foreground="#E0A84A" IsVisible="{Binding HasProfile}" />
          <ItemsControl ItemsSource="{Binding Equipment}" IsVisible="{Binding HasProfile}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ArmoryItemRow">
                <Border Width="250" Margin="0,0,8,6" Padding="6,4" CornerRadius="4" Background="#14FFFFFF">
                  <Grid ColumnDefinitions="36,*">
                    <Border Width="32" Height="32" CornerRadius="4" Background="#22000000" BorderBrush="{Binding GradeBrush}" BorderThickness="1">
                      <Image Source="{Binding Icon}" Width="30" Height="30" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                      <TextBlock Text="{Binding Name}" Foreground="{Binding GradeBrush}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Slot}" Classes="dim" FontSize="10.5" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding ProfileSkills}" Classes="dim" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding HasProfile}" />
          <TextBlock Text="{Binding ProfileStatus}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
