<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherDPS.App.ViewModels"
             xmlns:l="using:AetherDPS.App.Services"
             x:Class="AetherDPS.App.Views.PartyView"
             x:DataType="vm:PartyViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" Margin="12,4,22,22">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{l:T party.title}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="dim" FontSize="11" Text="{Binding Updated}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{l:T party.empty}" Classes="dim" IsVisible="{Binding !HasParty}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,140,70,120" IsVisible="{Binding HasParty}" Margin="6,0">
            <TextBlock Classes="dim" FontSize="11" Text="{l:T party.col.name}" />
            <TextBlock Grid.Column="1" Classes="dim" FontSize="11" Text="{l:T party.col.server}" />
            <TextBlock Grid.Column="2" Classes="dim" FontSize="11" Text="{l:T party.col.level}" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Classes="dim" FontSize="11" Text="{l:T party.col.power}" TextAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Members}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PartyRow">
                <Button Padding="0" Margin="0,0,0,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent"
                        Command="{Binding $parent[ItemsControl].((vm:PartyViewModel)DataContext).ShowMemberCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="{l:T armory.click_tip}">
                <Border Height="34" CornerRadius="4" Background="#14FFFFFF">
                  <Panel>
                    <ProgressBar Height="34" MinHeight="0" Maximum="100" Value="{Binding PowerPercent}" Foreground="{Binding ClassBrush}"
                                 Background="Transparent" Opacity="0.25" CornerRadius="4" />
                    <Grid ColumnDefinitions="*,140,70,120" Margin="6,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="{Binding ClassIcon}" Width="22" Height="22" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ClassName}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Server}" Classes="dim" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Level}" TextAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding CombatPower}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </Panel>
                </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{l:T party.note}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
          <CheckBox IsChecked="{Binding JoinPopup}">
            <StackPanel Spacing="2">
              <TextBlock Text="{l:T party.popup}" />
              <TextBlock Text="{l:T party.popup_hint}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
