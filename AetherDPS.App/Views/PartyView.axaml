<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherDPS.App.ViewModels"
             xmlns:l="using:AetherDPS.App.Services"
             x:Class="AetherDPS.App.Views.PartyView"
             x:DataType="vm:PartyViewModel">

  <!-- Daevas › Gruppe: aktuelle Mitglieder als Tabelle auf dem Rahmen, Kampfkraft als schmale
       Spur in Klassenfarbe; Klick öffnet das Profil. Darunter der Schalter fürs Einblenden. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="32,10,32,28" MaxWidth="980" HorizontalAlignment="Left">
      <StackPanel IsVisible="{Binding !HasParty}" Spacing="8" MaxWidth="560" HorizontalAlignment="Left" Margin="0,16,0,0">
        <TextBlock Classes="display" Text="{l:T party.empty_title}" />
        <TextBlock Classes="lead" Text="{l:T party.empty}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="2" IsVisible="{Binding HasParty}">
        <Grid ColumnDefinitions="*,150,70,120" Margin="12,0,12,6">
          <TextBlock Classes="section" Text="{l:T party.title}" />
          <TextBlock Grid.Column="1" Classes="small muted" Text="{l:T party.col.server}" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="2" Classes="small muted num" Text="{l:T party.col.level}" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="3" Classes="small muted num" Text="{l:T party.col.power}" VerticalAlignment="Bottom" />
        </Grid>
        <Border Classes="framerule" />
        <ItemsControl ItemsSource="{Binding Members}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PartyRow">
              <Button Classes="playerrow" ToolTip.Tip="{l:T armory.click_tip}"
                      Command="{Binding $parent[ItemsControl].((vm:PartyViewModel)DataContext).ShowMemberCommand}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="28,12,*,150,70,120">
                  <Image Source="{Binding ClassIcon}" Width="24" Height="24" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" />
                      <TextBlock Classes="small muted" Text="{Binding ClassName}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Classes="trace" Value="{Binding PowerPercent}" Foreground="{Binding ClassBrush}" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Classes="secondary" Text="{Binding Server}" VerticalAlignment="Center" Margin="12,0,0,0" />
                  <TextBlock Grid.Column="4" Classes="num secondary" Text="{Binding Level}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Classes="num" Text="{Binding CombatPower}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="small muted" Text="{Binding Updated}" Margin="12,6,0,0" />
      </StackPanel>

      <Border Classes="framerule" Margin="0,8,0,0" />
      <CheckBox IsChecked="{Binding JoinPopup}">
        <StackPanel Spacing="2">
          <TextBlock Text="{l:T party.popup}" />
          <TextBlock Classes="small muted" Text="{l:T party.popup_hint}" TextWrapping="Wrap" />
        </StackPanel>
      </CheckBox>
      <TextBlock Classes="small muted" Text="{l:T party.note}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
