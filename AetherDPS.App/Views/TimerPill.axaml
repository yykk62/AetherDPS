<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherDPS.App.ViewModels"
             xmlns:l="using:AetherDPS.App.Services"
             x:Class="AetherDPS.App.Views.TimerPill"
             x:DataType="vm:TimerRow"
             Width="150" Height="46">
  <!-- Eine Pill: alle gleich groß, Name oben klein, Restzeit groß -->
  <Border Name="Root" Background="{DynamicResource Surface.WellDeep}" CornerRadius="23" BorderBrush="{DynamicResource Line.Frame}" BorderThickness="1"
          Padding="16,4,16,5" ToolTip.Tip="{Binding At}">
    <StackPanel VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{Binding Icon, Converter={x:Static l:Icons.ByName}}" Width="11" Height="11" />
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text.Muted}" FontSize="10.5" FontWeight="SemiBold" MaxWidth="100" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Text="{Binding Remaining}" FontSize="15" FontWeight="Bold" Margin="0,-1,0,0"
                 Foreground="{Binding IsSoon, Converter={x:Static l:BoolBrush.DueGreenElseText}}" />
    </StackPanel>
  </Border>
</UserControl>
