<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherDPS.App.ViewModels"
             xmlns:l="using:AetherDPS.App.Services"
             x:Class="AetherDPS.App.Views.ChecklistView"
             x:DataType="vm:ChecklistViewModel">

  <!-- Welt › Checkliste: täglich und wöchentlich nebeneinander, je mit großem Fortschritt
       („4/9“ und sich füllende Spur) und der Zeit bis zum Reset. Anlegen und Reset-Zeiten darunter. -->
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:ChecklistRow">
      <Grid Classes="checkrow" ColumnDefinitions="*,Auto" Background="Transparent">
        <CheckBox IsChecked="{Binding IsDone}" Classes.done="{Binding IsDone}">
          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
        </CheckBox>
        <Button Grid.Column="1" Classes="icon rm" Padding="7" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:T check.remove}">
          <Image Source="{l:Icon close, Size=11}" Width="11" Height="11" />
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="24" Margin="32,10,32,28">
      <Grid ColumnDefinitions="*,20,*">
        <Border Classes="well" VerticalAlignment="Top">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="section" Text="{l:T check.daily}" />
                <TextBlock Classes="small muted" Text="{Binding DailyInfo}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="reading" Text="{Binding DailyProgress}" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar Classes="fill" Value="{Binding DailyPercent}" />
            <ItemsControl ItemsSource="{Binding Daily}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="well" VerticalAlignment="Top">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="section" Text="{l:T check.weekly}" />
                <TextBlock Classes="small muted" Text="{Binding WeeklyInfo}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="reading" Text="{Binding WeeklyProgress}" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar Classes="fill" Value="{Binding WeeklyPercent}" />
            <ItemsControl ItemsSource="{Binding Weekly}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="*,36,*">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{l:T check.add_title}" />
          <TextBox Text="{Binding NewText}" Watermark="{l:T check.add_hint}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox IsChecked="{Binding NewIsWeekly}" Content="{l:T check.weekly_short}" />
            <Button Classes="quiet" Content="{l:T check.add}" Command="{Binding AddCommand}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="8">
          <TextBlock Classes="section" Text="{l:T check.resets}" />
          <WrapPanel>
            <TextBlock Classes="secondary" Text="{l:T check.daily_reset}" VerticalAlignment="Center" Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding Hours}" SelectedIndex="{Binding DailyHour}" Width="90" Margin="0,0,16,6" />
            <TextBlock Classes="secondary" Text="{l:T check.weekly_reset}" VerticalAlignment="Center" Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding Days}" SelectedIndex="{Binding WeeklyDay}" Width="130" Margin="0,0,6,6" />
            <ComboBox ItemsSource="{Binding Hours}" SelectedIndex="{Binding WeeklyHour}" Width="90" Margin="0,0,0,6" />
          </WrapPanel>
          <TextBlock Classes="small muted" Text="{l:T check.reset_note}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>

  <UserControl.Styles>
    <Style Selector="Grid.checkrow">
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <!-- Entfernen erst bei Maus über der Zeile -->
    <Style Selector="Grid.checkrow Button.rm">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid.checkrow:pointerover Button.rm">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="CheckBox.done TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
  </UserControl.Styles>
</UserControl>
