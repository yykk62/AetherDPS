<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherDPS.App.ViewModels"
        xmlns:views="using:AetherDPS.App.Views"
        xmlns:l="using:AetherDPS.App.Services"
        x:Class="AetherDPS.App.Views.HubWindow"
        x:DataType="vm:HubViewModel"
        Title="{l:T hub.title}"
        Width="1000" Height="700" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#0E1117" Icon="/Assets/icon.ico">

  <!-- Aufbau: links feste Seitenleiste (Logo, Navigation in Gruppen, Status, kleine Knöpfe),
       rechts Kopfzeile mit Seitentitel und Hauptaktion, darunter die jeweilige Seite.
       Hinweiskarten liegen nur auf der Übersicht; die Navigation zeigt dort eine Zahl. -->
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E6E8EC" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#8E96A3" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Navigation -->
    <Style Selector="TextBlock.group">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#59616F" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Margin" Value="14,16,0,5" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0FFFFFFF" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#1AE0A84A" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#24E0A84A" />
    </Style>
    <Style Selector="Button.nav Image.navic">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav.active Image.navic">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.nav TextBlock.navtx">
      <Setter Property="Foreground" Value="#9AA3B2" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style Selector="Button.nav.active TextBlock.navtx">
      <Setter Property="Foreground" Value="#F2EBDD" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav:pointerover TextBlock.navtx">
      <Setter Property="Foreground" Value="#D5DAE2" />
    </Style>

    <!-- Kacheln (Verbindung), Hinweiskarten, Chips -->
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="#F2191E28" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="BorderBrush" Value="#262E3B" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6,6,6" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#141A24" />
      <Setter Property="BorderBrush" Value="#262E3B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="Margin" Value="0,0,8,6" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="212,*">

    <!-- ===== Seitenleiste ===== -->
    <Border Background="#0A0D13" BorderBrush="#1A2029" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,18,14,6">
          <Image Source="/Assets/icon.png" Width="36" Height="36" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock Text="{l:T hub.title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VersionText}" Classes="dim" FontSize="10.5" />
          </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10,0,10,8">
            <TextBlock Classes="group" Text="{l:T nav.group.start}" />
            <Button Classes="nav" Classes.active="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=0}" Command="{Binding SelectTabCommand}" CommandParameter="0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Classes="navic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon swords, Size=18}" />
                <TextBlock Grid.Column="1" Classes="navtx" Text="{l:T nav.overview}" />
                <Border Grid.Column="2" IsVisible="{Binding HasNotices}" Background="#E0A84A" CornerRadius="9" MinWidth="18" Height="18" Padding="6,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding NoticeCount}" Foreground="#141820" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=1}" Command="{Binding SelectTabCommand}" CommandParameter="1">
              <Grid ColumnDefinitions="Auto,*">
                <Image Classes="navic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon trophy, Size=18}" />
                <TextBlock Grid.Column="1" Classes="navtx" Text="{l:T hub.tab.runs}" />
              </Grid>
            </Button>

            <TextBlock Classes="group" Text="{l:T nav.group.character}" />
            <Button Classes="nav" Classes.active="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=3}" Command="{Binding SelectTabCommand}" CommandParameter="3">
              <Grid ColumnDefinitions="Auto,*">
                <Image Classes="navic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon helmet, Size=18}" />
                <TextBlock Grid.Column="1" Classes="navtx" Text="{l:T hub.tab.profile}" />
              </Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=2}" Command="{Binding SelectTabCommand}" CommandParameter="2">
              <Grid ColumnDefinitions="Auto,*">
                <Image Classes="navic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon group, Size=18}" />
                <TextBlock Grid.Column="1" Classes="navtx" Text="{l:T hub.tab.party}" />
              </Grid>
            </Button>

            <TextBlock Classes="group" Text="{l:T nav.group.world}" />
            <Button Classes="nav" Classes.active="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=4}" Command="{Binding SelectTabCommand}" CommandParameter="4">
              <Grid ColumnDefinitions="Auto,*">
                <Image Classes="navic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon paw, Size=18}" />
                <TextBlock Grid.Column="1" Classes="navtx" Text="{l:T hub.tab.pets}" />
              </Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=5}" Command="{Binding SelectTabCommand}" CommandParameter="5">
              <Grid ColumnDefinitions="Auto,*">
                <Image Classes="navic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon hourglass, Size=18}" />
                <TextBlock Grid.Column="1" Classes="navtx" Text="{l:T hub.tab.timers}" />
              </Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=6}" Command="{Binding SelectTabCommand}" CommandParameter="6">
              <Grid ColumnDefinitions="Auto,*">
                <Image Classes="navic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon checklist, Size=18}" />
                <TextBlock Grid.Column="1" Classes="navtx" Text="{l:T hub.tab.checklist}" />
              </Grid>
            </Button>

            <TextBlock Classes="group" Text="{l:T nav.group.system}" />
            <Button Classes="nav" Classes.active="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=7}" Command="{Binding SelectTabCommand}" CommandParameter="7">
              <Grid ColumnDefinitions="Auto,*">
                <Image Classes="navic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon signal, Size=18}" />
                <TextBlock Grid.Column="1" Classes="navtx" Text="{l:T hub.tab.connection}" />
              </Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=8}" Command="{Binding SelectTabCommand}" CommandParameter="8">
              <Grid ColumnDefinitions="Auto,*">
                <Image Classes="navic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon gear, Size=18}" />
                <TextBlock Grid.Column="1" Classes="navtx" Text="{l:T hub.tab.settings}" />
              </Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <!-- Status und kleine Knöpfe -->
        <StackPanel Grid.Row="2" Margin="12,6,12,12" Spacing="8">
          <Border Background="#10151D" BorderBrush="#1A2029" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <StackPanel Spacing="5">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Overlay.IsConnected, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
                <TextBlock Text="{Binding Overlay.StatusText}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Overlay.StatusText}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding GameRunning, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
                <TextBlock Text="{Binding LaunchText}" Classes="dim" FontSize="11.5" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </Border>
          <UniformGrid Rows="1">
            <Button Classes="plain" HorizontalAlignment="Center" Command="{Binding OpenDiscordCommand}" ToolTip.Tip="{l:T hub.discord}"
                    IsVisible="{Binding DiscordUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon chat, Size=16}" Width="16" Height="16" />
            </Button>
            <Button Classes="plain" HorizontalAlignment="Center" Command="{Binding ReportProblemCommand}" ToolTip.Tip="{l:T hub.report}">
              <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon megaphone, Size=16}" Width="16" Height="16" />
            </Button>
            <Button Classes="plain" HorizontalAlignment="Center" Command="{Binding OpenDataFolderCommand}" ToolTip.Tip="{l:T hub.folder}">
              <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon folder, Size=16}" Width="16" Height="16" />
            </Button>
          </UniformGrid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Inhalt ===== -->
    <Panel Grid.Column="1">
      <!-- Wasserzeichen unten rechts, oben links in die Grundfarbe auslaufend -->
      <Image Source="/Assets/art/hub-bg.jpg" Stretch="UniformToFill" IsHitTestVisible="False"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderOptions.BitmapInterpolationMode="HighQuality" />
      <Border IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FF0E1117" Offset="0" />
            <GradientStop Color="#CC0E1117" Offset="0.35" />
            <GradientStop Color="#330E1117" Offset="0.75" />
            <GradientStop Color="#000E1117" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Grid RowDefinitions="Auto,*">
        <!-- Kopfzeile: Seitentitel, rechts Update und Hauptaktion -->
        <Grid ColumnDefinitions="*,Auto" Margin="28,22,28,12">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PageSubtitle}" Classes="dim" FontSize="12.5" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding UpdateBanner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding UpdateBanner}" Foreground="#E0A84A" FontSize="12" VerticalAlignment="Center" />
              <Button Classes="secondary" Command="{Binding RestartForUpdateCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon download, Size=14}" Width="14" Height="14" />
                  <TextBlock Text="{l:T update.restart_short}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Button Classes="primary" Content="{Binding ToggleText}" Command="{Binding ToggleMeterCommand}" IsVisible="{Binding ShowHeaderToggle}" />
          </StackPanel>
        </Grid>

        <Panel Grid.Row="1">

          <!-- ===== Übersicht ===== -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=0}">
            <StackPanel Spacing="12" Margin="28,0,28,24">

              <!-- Status -->
              <Border Classes="card" Padding="20,18">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="50" Height="50" CornerRadius="25" VerticalAlignment="Top" Margin="0,0,16,0"
                          Background="{Binding IsActive, Converter={x:Static l:BoolBrush.ActiveGreenElseGoldTile}}">
                    <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon swords, Size=26}" Width="26" Height="26" HorizontalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding IsActive, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
                      <TextBlock Text="{Binding ModeTitle}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding ModeText}" Classes="dim" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,10,0,0">
                      <Border Classes="chip" IsVisible="{Binding GameRunning}" Background="#145CC26A" BorderBrush="#335CC26A">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="7" Height="7" Fill="#5CC26A" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding LaunchText}" Foreground="#9BDCA4" />
                        </StackPanel>
                      </Border>
                      <Button Classes="secondary" Padding="11,4" Margin="0,0,8,6" Command="{Binding LaunchGameCommand}" IsVisible="{Binding !GameRunning}" ToolTip.Tip="{l:T hub.launch_hint}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon play, Size=12}" Width="12" Height="12" />
                          <TextBlock Text="{Binding LaunchText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Border Classes="chip">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon helmet, Size=13}" Width="13" Height="13" />
                          <TextBlock Text="{Binding CharacterLine}" Classes="dim" />
                        </StackPanel>
                      </Border>
                      <Border Classes="chip" IsVisible="{Binding RiftInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon hourglass, Size=13}" Width="13" Height="13" />
                          <TextBlock Text="{Binding RiftInfo}" Foreground="#E0A84A" />
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                  <Button Grid.Column="2" Classes="primary" Content="{Binding ToggleText}" Command="{Binding ToggleMeterCommand}"
                          FontSize="14" Padding="24,11" VerticalAlignment="Center" Margin="16,0,0,0" IsVisible="{Binding !IsAuto}" />
                </Grid>
              </Border>

              <!-- Hinweise: Zustimmung, Absturz, Was ist neu, Nachrichten an alle, Spiel-Update -->
              <ItemsControl ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HubNotice">
                    <Border Classes="notice"
                            Background="{Binding IsWarning, Converter={x:Static l:BoolBrush.WarningElseCard}}"
                            BorderBrush="{Binding IsWarning, Converter={x:Static l:BoolBrush.WarningBorderElseCard}}">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{Binding Icon, Converter={x:Static l:Icons.ByName}}" Width="16" Height="16" Margin="2,0,0,0" />
                          <Button Grid.Column="1" Classes="plain" Command="{Binding ToggleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,3">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                          </Button>
                          <Button Grid.Column="2" Classes="plain" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding IsExpanded, Converter={x:Static vm:NoticeConv.CollapseElseExpandTip}}">
                            <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{Binding IsExpanded, Converter={x:Static vm:NoticeConv.ChevronUpElseDown}}" Width="12" Height="12" />
                          </Button>
                          <Button Grid.Column="3" Classes="plain" Command="{Binding Close}" IsVisible="{Binding CanClose}">
                            <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon close, Size=11}" Width="11" Height="11" />
                          </Button>
                        </Grid>
                        <StackPanel Spacing="8" Margin="26,0,6,4" IsVisible="{Binding IsExpanded}">
                          <TextBlock Text="{Binding Text}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                          <Border IsVisible="{Binding HasDetail}" Background="#0E1117" CornerRadius="4" Padding="10,6">
                            <SelectableTextBlock Text="{Binding Detail}" FontFamily="Consolas,monospace" FontSize="12" Foreground="#C8CDD6" TextWrapping="Wrap" />
                          </Border>
                          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPrimary}">
                            <Button Classes="primary" Content="{Binding PrimaryText}" Command="{Binding Primary}" IsVisible="{Binding HasPrimary}" />
                            <Button Classes="secondary" Content="{Binding SecondaryText}" Command="{Binding Secondary}" IsVisible="{Binding HasSecondary}" />
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Aktueller / letzter Lauf -->
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h2" Text="{l:T hub.run.title}" />
                    <Button Grid.Column="1" Classes="plain" Command="{Binding SelectTabCommand}" CommandParameter="1" ToolTip.Tip="{l:T hub.tab.runs}" IsVisible="{Binding HasRun}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{l:T hub.tab.runs}" Foreground="#E0A84A" FontSize="12" VerticalAlignment="Center" />
                        <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon chevron-right, Size=11}" Width="11" Height="11" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding RunSummary}" Classes="dim" IsVisible="{Binding HasRun}" />
                  <TextBlock Text="{l:T hub.run.empty}" Classes="dim" IsVisible="{Binding !HasRun}" />
                  <ItemsControl ItemsSource="{Binding RunPlayers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PlayerRow">
                        <Border Height="30" CornerRadius="4" Background="#14FFFFFF" Margin="0,0,0,3">
                          <Panel>
                            <ProgressBar Height="30" MinHeight="0" Maximum="100" Value="{Binding BarPercent}" Foreground="{Binding ClassBrush}"
                                         Background="Transparent" Opacity="0.35" CornerRadius="4" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="6,0,10,0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{Binding ClassIcon}" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ClassName}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding Dps}" FontWeight="SemiBold" MinWidth="70" TextAlignment="Right" />
                              <TextBlock Grid.Column="2" Text="{Binding Total}" Classes="dim" MinWidth="60" TextAlignment="Right" />
                              <TextBlock Grid.Column="3" Text="{Binding Share}" Classes="dim" MinWidth="56" TextAlignment="Right" />
                            </Grid>
                          </Panel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <views:RunsView DataContext="{Binding Runs}" Margin="16,-4,6,2" IsVisible="{Binding $parent[Window].((vm:HubViewModel)DataContext).SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=1}" />
          <views:PartyView DataContext="{Binding Party}" Margin="16,-4,6,2" IsVisible="{Binding $parent[Window].((vm:HubViewModel)DataContext).SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=2}" />
          <views:ProfileView DataContext="{Binding Profile}" Margin="16,-4,6,2" IsVisible="{Binding $parent[Window].((vm:HubViewModel)DataContext).SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=3}" />
          <views:PetsView DataContext="{Binding Pets}" Margin="16,-4,6,2" IsVisible="{Binding $parent[Window].((vm:HubViewModel)DataContext).SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=4}" />
          <views:TimersView DataContext="{Binding Timers}" Margin="16,-4,6,2" IsVisible="{Binding $parent[Window].((vm:HubViewModel)DataContext).SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=5}" />
          <views:ChecklistView DataContext="{Binding Checklist}" Margin="16,-4,6,2" IsVisible="{Binding $parent[Window].((vm:HubViewModel)DataContext).SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=6}" />

          <!-- ===== Verbindung ===== -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=7}">
            <StackPanel Spacing="12" Margin="28,0,28,24">
              <Grid ColumnDefinitions="*,*,*,*,*">
                <Border Grid.Column="0" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.now}" /><TextBlock Text="{Binding PingNow}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="1" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.avg}" /><TextBlock Text="{Binding PingAvg}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="2" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.jitter}" /><TextBlock Text="{Binding PingJitter}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="3" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.spikes}" /><TextBlock Text="{Binding SpikeCount}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="4" Classes="tile" Margin="0"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.retrans}" /><TextBlock Text="{Binding Retransmits}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
              </Grid>

              <Border Classes="card">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h2" Text="{l:T conn.graph}" />
                    <TextBlock Grid.Column="1" Classes="dim" FontSize="11" Text="{Binding ServerText}" VerticalAlignment="Center" />
                  </Grid>
                  <Panel Height="190">
                    <views:PingGraph Samples="{Binding PingSamples}" SpikeThreshold="{Binding SpikeThreshold}" />
                    <TextBlock Text="{l:T conn.no_data}" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasPingData}" />
                  </Panel>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h2" Text="{l:T conn.check}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="primary" Content="{l:T conn.check}" Command="{Binding DiagnoseCommand}" IsEnabled="{Binding !IsDiagnosing}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding DiagnosisRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DiagnosisRow">
                        <Grid ColumnDefinitions="Auto,170,*" Margin="0,3">
                          <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Fill="{Binding Ok, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="2" Text="{Binding Result}" Classes="dim" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding DiagnosisText}" TextWrapping="Wrap" FontSize="13" />
                  <TextBlock Text="{l:T conn.note}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ===== Einstellungen ===== -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding SelectedTab, Converter={x:Static l:TabIs.Instance}, ConverterParameter=8}">
            <views:SettingsView DataContext="{Binding Settings}" Margin="28,0,28,24" />
          </ScrollViewer>
        </Panel>
      </Grid>
    </Panel>
  </Grid>
</Window>
