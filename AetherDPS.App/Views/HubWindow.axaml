<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherDPS.App.ViewModels"
        xmlns:views="using:AetherDPS.App.Views"
        xmlns:l="using:AetherDPS.App.Services"
        x:Class="AetherDPS.App.Views.HubWindow"
        x:DataType="vm:HubViewModel"
        Title="{l:T hub.title}"
        Width="860" Height="660" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#11141B" Icon="/Assets/icon.ico">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E6E8EC" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#8E96A3" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#191E28" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BorderBrush" Value="#232A36" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#E0A84A" />
      <Setter Property="Foreground" Value="#141820" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="20,9" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0BC62" />
      <Setter Property="Foreground" Value="#141820" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="#8E96A3" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#E6E8EC" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="#E0A84A" />
    </Style>
    <!-- Reiter: Icon + Text, inaktiv gedämpft -->
    <Style Selector="TabItem StackPanel.tab">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="10" />
    </Style>
    <Style Selector="TabItem Image.tab">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="TabItem:selected Image.tab">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TabItem TextBlock.tab">
      <Setter Property="Foreground" Value="#8E96A3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TabItem:selected TextBlock.tab">
      <Setter Property="Foreground" Value="#E6E8EC" />
    </Style>
    <Style Selector="TabItem:pointerover TextBlock.tab">
      <Setter Property="Foreground" Value="#C9CED6" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="#191E28" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="BorderBrush" Value="#232A36" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>

  <Panel>
  <!-- Flügel als dunkles Wasserzeichen unten rechts, Karten liegen darüber -->
  <Image Source="/Assets/art/hub-bg.jpg" Stretch="UniformToFill" Opacity="0.7" IsHitTestVisible="False"
         HorizontalAlignment="Stretch" VerticalAlignment="Bottom" RenderOptions.BitmapInterpolationMode="HighQuality" />
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- Kopf -->
    <Grid ColumnDefinitions="*,Auto" Margin="22,16,22,4">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Image Source="/Assets/icon.png" Width="28" Height="28" />
        <TextBlock Text="{l:T hub.title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="{l:T hub.close_hint}" Classes="dim" FontSize="11" VerticalAlignment="Center" Margin="12,2,0,0" />
      </StackPanel>
      <!-- Update bereit -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding UpdateBanner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding UpdateBanner}" Foreground="#E0A84A" FontSize="12" VerticalAlignment="Center" />
          <Button Classes="primary" Command="{Binding RestartForUpdateCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon download, Size=14}" Width="14" Height="14" />
              <TextBlock Text="{l:T update.restart_short}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button Classes="secondary" Command="{Binding OpenDiscordCommand}"
                IsVisible="{Binding DiscordUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon chat, Size=14}" Width="14" Height="14" />
            <TextBlock Text="{l:T hub.discord}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Hinweiskarten: Zustimmung, Absturz, Was ist neu, Nachrichten an alle, Spiel-Update -->
    <ScrollViewer Grid.Row="1" MaxHeight="240" HorizontalScrollBarVisibility="Disabled" Margin="22,6,22,0">
    <ItemsControl ItemsSource="{Binding Notices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:HubNotice">
          <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,8" BorderThickness="1"
                  Background="{Binding IsWarning, Converter={x:Static l:BoolBrush.WarningElseCard}}"
                  BorderBrush="{Binding IsWarning, Converter={x:Static l:BoolBrush.WarningBorderElseCard}}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{Binding Icon, Converter={x:Static l:Icons.ByName}}" Width="18" Height="18" />
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Text}" Classes="dim" TextWrapping="Wrap" />
                <Border IsVisible="{Binding HasDetail}" Background="#0E1117" CornerRadius="4" Padding="10,6">
                  <SelectableTextBlock Text="{Binding Detail}" FontFamily="Consolas,monospace" FontSize="12" Foreground="#C8CDD6" TextWrapping="Wrap" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                  <Button Classes="primary" Content="{Binding PrimaryText}" Command="{Binding Primary}" IsVisible="{Binding HasPrimary}" />
                  <Button Classes="secondary" Content="{Binding SecondaryText}" Command="{Binding Secondary}" IsVisible="{Binding HasSecondary}" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="1" Command="{Binding Close}" IsVisible="{Binding CanClose}"
                      VerticalAlignment="Top" Background="Transparent" Padding="8,4">
                <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon close, Size=12}" Width="12" Height="12" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>

    <TabControl Grid.Row="2" TabStripPlacement="Left" SelectedIndex="{Binding SelectedTab}" Margin="10,6,0,0">

      <!-- DPS-Meter -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Classes="tab">
            <Image Classes="ic tab" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon swords, Size=18}" />
            <TextBlock Classes="tab" Text="{l:T hub.tab.dps}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="12,4,22,22">
            <Border Classes="card">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,12,0"
                         Fill="{Binding IsActive, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
                <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,16,0">
                  <TextBlock Text="{Binding ModeTitle}" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ModeText}" Classes="dim" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RiftInfo}" Foreground="#E0A84A" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button Classes="secondary" Command="{Binding LaunchGameCommand}" IsEnabled="{Binding !GameRunning}">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon play, Size=13}" Width="13" Height="13" />
                        <TextBlock Text="{Binding LaunchText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <TextBlock Text="{l:T hub.launch_hint}" Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="380" />
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Classes="primary" Content="{Binding ToggleText}" Command="{Binding ToggleMeterCommand}" VerticalAlignment="Center" IsVisible="{Binding !IsAuto}" />
              </Grid>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="{l:T hub.run.title}" />
                <TextBlock Text="{Binding RunSummary}" Classes="dim" IsVisible="{Binding HasRun}" />
                <TextBlock Text="{l:T hub.run.empty}" Classes="dim" IsVisible="{Binding !HasRun}" />
                <TextBlock Text="{Binding CharacterLine}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding RunPlayers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                      <Border Height="30" CornerRadius="4" Background="#14FFFFFF" Margin="0,0,0,3">
                        <Panel>
                          <ProgressBar Height="30" MinHeight="0" Maximum="100" Value="{Binding BarPercent}" Foreground="{Binding ClassBrush}"
                                       Background="Transparent" Opacity="0.35" CornerRadius="4" />
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="6,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Image Source="{Binding ClassIcon}" Width="22" Height="22" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding ClassName}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Dps}" FontWeight="SemiBold" MinWidth="70" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding Total}" Classes="dim" MinWidth="60" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding Share}" Classes="dim" MinWidth="56" TextAlignment="Right" />
                          </Grid>
                        </Panel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="2,0,8,0"
                       Fill="{Binding Overlay.IsConnected, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
              <TextBlock Grid.Column="1" Text="{Binding Overlay.StatusText}" Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Classes="secondary" Command="{Binding ReportProblemCommand}" Margin="8,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon megaphone, Size=14}" Width="14" Height="14" />
            <TextBlock Text="{l:T hub.report}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
              <Button Grid.Column="3" Classes="secondary" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon folder, Size=14}" Width="14" Height="14" />
            <TextBlock Text="{l:T hub.folder}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Classes="tab">
            <Image Classes="ic tab" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon trophy, Size=18}" />
            <TextBlock Classes="tab" Text="{l:T hub.tab.runs}" />
          </StackPanel>
        </TabItem.Header>
        <views:RunsView DataContext="{Binding Runs}" />
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Classes="tab">
            <Image Classes="ic tab" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon group, Size=18}" />
            <TextBlock Classes="tab" Text="{l:T hub.tab.party}" />
          </StackPanel>
        </TabItem.Header>
        <views:PartyView DataContext="{Binding Party}" />
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Classes="tab">
            <Image Classes="ic tab" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon helmet, Size=18}" />
            <TextBlock Classes="tab" Text="{l:T hub.tab.profile}" />
          </StackPanel>
        </TabItem.Header>
        <views:ProfileView DataContext="{Binding Profile}" />
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Classes="tab">
            <Image Classes="ic tab" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon paw, Size=18}" />
            <TextBlock Classes="tab" Text="{l:T hub.tab.pets}" />
          </StackPanel>
        </TabItem.Header>
        <views:PetsView DataContext="{Binding Pets}" />
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Classes="tab">
            <Image Classes="ic tab" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon hourglass, Size=18}" />
            <TextBlock Classes="tab" Text="{l:T hub.tab.timers}" />
          </StackPanel>
        </TabItem.Header>
        <views:TimersView DataContext="{Binding Timers}" />
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Classes="tab">
            <Image Classes="ic tab" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon checklist, Size=18}" />
            <TextBlock Classes="tab" Text="{l:T hub.tab.checklist}" />
          </StackPanel>
        </TabItem.Header>
        <views:ChecklistView DataContext="{Binding Checklist}" />
      </TabItem>

      <!-- Verbindung -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Classes="tab">
            <Image Classes="ic tab" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon signal, Size=18}" />
            <TextBlock Classes="tab" Text="{l:T hub.tab.connection}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="12,4,22,22">
            <Grid ColumnDefinitions="*,*,*,*,*">
              <Border Grid.Column="0" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.now}" /><TextBlock Text="{Binding PingNow}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="1" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.avg}" /><TextBlock Text="{Binding PingAvg}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="2" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.jitter}" /><TextBlock Text="{Binding PingJitter}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="3" Classes="tile"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.spikes}" /><TextBlock Text="{Binding SpikeCount}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="4" Classes="tile" Margin="0"><StackPanel><TextBlock Classes="dim" FontSize="11" Text="{l:T conn.retrans}" /><TextBlock Text="{Binding Retransmits}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
            </Grid>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h2" Text="{l:T conn.graph}" />
                  <TextBlock Grid.Column="1" Classes="dim" FontSize="11" Text="{Binding ServerText}" VerticalAlignment="Center" />
                </Grid>
                <Panel Height="190">
                  <views:PingGraph Samples="{Binding PingSamples}" SpikeThreshold="{Binding SpikeThreshold}" />
                  <TextBlock Text="{l:T conn.no_data}" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasPingData}" />
                </Panel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h2" Text="{l:T conn.check}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="primary" Content="{l:T conn.check}" Command="{Binding DiagnoseCommand}" IsEnabled="{Binding !IsDiagnosing}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding DiagnosisRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiagnosisRow">
                      <Grid ColumnDefinitions="Auto,170,*" Margin="0,3">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Fill="{Binding Ok, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding Result}" Classes="dim" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding DiagnosisText}" TextWrapping="Wrap" FontSize="13" />
                <TextBlock Text="{l:T conn.note}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Einstellungen -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Classes="tab">
            <Image Classes="ic tab" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon gear, Size=18}" />
            <TextBlock Classes="tab" Text="{l:T hub.tab.settings}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <views:SettingsView DataContext="{Binding Settings}" Margin="12,4,22,22" />
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
  </Panel>
</Window>
