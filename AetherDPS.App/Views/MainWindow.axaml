<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherDPS.App.ViewModels"
        xmlns:l="using:AetherDPS.App.Services"
        x:Class="AetherDPS.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Classes="ins"
        Title="{l:T app.title}"
        Width="380" MinWidth="260" SizeToContent="Height" MaxHeight="720"
        SystemDecorations="None" Topmost="True" CanResize="True" ShowActivated="False"
        TransparencyLevelHint="Transparent" Background="Transparent"
        FontFamily="{DynamicResource Font.Ui}"
        Icon="/Assets/icon.ico">

  <!-- Kampfanzeige (docs/DESIGN.md): das Spiel ist der Rahmen, die Anzeige eine einzige Mulde.
       Oben das Ziel mit Leben und Stagger in einer gravierten Rille, darunter die Spieler mit schmaler
       Klassenspur (deine Zeile mit Goldkante und Zeichen). Bedienelemente nur unter der Maus. -->
  <Window.Styles>
    <Style Selector="Button.ovl, ToggleButton.ovl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Mark}" />
    </Style>
    <Style Selector="Button.ovl:pointerover /template/ ContentPresenter, ToggleButton.ovl:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
    </Style>
    <Style Selector="ToggleButton.ovl:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
    </Style>
    <!-- Zahlen mit leichtem Schatten, damit sie auf jedem Spielhintergrund lesbar bleiben -->
    <Style Selector="TextBlock.shade">
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="2" OffsetX="0" OffsetY="1" Color="#C0000000" />
      </Setter>
    </Style>
    <Style Selector="ProgressBar.band">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <!-- Spielerzeile: ganze Zeile klickbar (Skills), deine mit Goldkante -->
    <Style Selector="Border.prow">
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
      <Setter Property="Padding" Value="6,4,8,5" />
      <Setter Property="Margin" Value="0,0,0,1" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.prow:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    </Style>
    <Style Selector="Border.prow.me">
      <Setter Property="Background" Value="{DynamicResource Surface.Self}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Self}" />
    </Style>
    <Style Selector="Border.prow.selected">
      <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
    </Style>
  </Window.Styles>

  <Border Name="Root" Background="{DynamicResource Surface.WellDeep}" CornerRadius="{DynamicResource Radius.Well}" BorderThickness="1" Padding="8"
          BorderBrush="{Binding IsClickThrough, Converter={x:Static l:BoolBrush.LockedGoldElseSubtle}}">
    <Panel>
    <StackPanel Spacing="6">

      <!-- ============ Mini-Leiste (kein Kampf) ============ -->
      <Grid Name="CompactBar" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsCompact}" Background="Transparent">
        <Border Width="30" Height="30" CornerRadius="{DynamicResource Radius.Control}" Background="{DynamicResource Surface.Raised}" VerticalAlignment="Center">
          <Panel>
            <Image Source="{Binding SelfIcon}" Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <Image Source="/Assets/icon.png" Width="18" Height="18" IsVisible="{Binding SelfIcon, Converter={x:Static ObjectConverters.IsNull}}" />
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="0">
          <TextBlock Classes="self" Text="{Binding SelfName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="small muted" Text="{Binding CompactInfo}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" IsVisible="{Binding #Root.IsPointerOver}">
            <Button Classes="ovl" Click="OnPlaceClicked" ToolTip.Tip="{Binding PlacementTip}"><Image Source="{l:Icon drag, Size=13}" Width="13" Height="13" /></Button>
            <Button Classes="ovl" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{l:T header.settings}"><Image Source="{l:Icon gear, Size=13}" Width="13" Height="13" /></Button>
            <Button Classes="ovl" Click="OnCloseClicked" ToolTip.Tip="{l:T header.close}"><Image Source="{l:Icon close, Size=11}" Width="11" Height="11" /></Button>
          </StackPanel>
          <Border Width="24" />
        </StackPanel>
      </Grid>

      <!-- ============ Ziel ============ -->
      <Border Name="Header" Background="Transparent" Padding="2,0,2,2" IsVisible="{Binding !IsCompact}">
        <StackPanel Spacing="5">
          <!-- Zeile 1: Art, Kampfzeit, Tode, Zeitlimit – Knöpfe nur unter der Maus -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Image Source="{l:Icon skull, Size=13}" Width="13" Height="13" IsVisible="{Binding IsBoss}" />
                <TextBlock Classes="small muted" Text="{Binding CardLabel}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="small" Text="{Binding Duration}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasDeaths}" ToolTip.Tip="{l:T card.deaths_tip}">
                <Image Source="{l:Icon skull, Size=11}" Width="11" Height="11" />
                <TextBlock Classes="small" Text="{Binding DeathsText}" Foreground="{DynamicResource Signal.Bad}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{l:T card.limit_tip}"
                          IsVisible="{Binding LimitText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Image Source="{l:Icon stopwatch, Size=11}" Width="11" Height="11" />
                <TextBlock Classes="small" Text="{Binding LimitText}" VerticalAlignment="Center"
                           Foreground="{Binding LimitUrgent, Converter={x:Static l:BoolBrush.ErrorRedElseText}}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,-3,-4,-3">
              <StackPanel Orientation="Horizontal" IsVisible="{Binding #Root.IsPointerOver}">
                <Button Classes="ovl" Content="{Binding ViewLabel}" Command="{Binding ToggleViewCommand}" ToolTip.Tip="{l:T view.tooltip}" FontSize="11" />
                <Button Classes="ovl" Command="{Binding ResetCommand}" ToolTip.Tip="{l:T header.reset}"><Image Source="{l:Icon reset, Size=13}" Width="13" Height="13" /></Button>
                <ToggleButton Classes="ovl" IsChecked="{Binding ShowDetails}" Command="{Binding ToggleDetailsCommand}" ToolTip.Tip="{l:T header.details}"><Image Source="{l:Icon menu, Size=13}" Width="13" Height="13" /></ToggleButton>
                <Button Classes="ovl" Click="OnPlaceClicked" ToolTip.Tip="{Binding PlacementTip}"><Image Source="{l:Icon drag, Size=13}" Width="13" Height="13" /></Button>
                <Button Classes="ovl" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{l:T header.settings}"><Image Source="{l:Icon gear, Size=13}" Width="13" Height="13" /></Button>
                <Button Classes="ovl" Click="OnCloseClicked" ToolTip.Tip="{l:T header.close}"><Image Source="{l:Icon close, Size=11}" Width="11" Height="11" /></Button>
              </StackPanel>
              <Border Width="22" />
            </StackPanel>
          </Grid>

          <!-- Zeile 2: Name und Leben in Prozent -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding TargetName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="shade" Text="{Binding HpPercentText}" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasTarget}" />
          </Grid>

          <!-- Rille: oben Leben, darunter Stagger (nur in der Phase) -->
          <Border Background="{DynamicResource Surface.Well}" CornerRadius="4" Padding="2" IsVisible="{Binding ShowHpBar}">
            <StackPanel Spacing="2">
              <ProgressBar Classes="band" Height="6" Value="{Binding TargetHpPercent}" Foreground="{DynamicResource Signal.Good}" />
              <ProgressBar Classes="band" Height="4" Value="{Binding StaggerPercent}" Foreground="{DynamicResource Accent.Phase}" IsVisible="{Binding StaggerVisible}" />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowHpBar}">
            <TextBlock Classes="small" Text="{Binding StaggerText}" Foreground="{DynamicResource Accent.Phase}" IsVisible="{Binding StaggerVisible}" />
            <TextBlock Grid.Column="1" Classes="small muted" Text="{Binding HpText}" />
          </Grid>
          <!-- Stagger ohne Lebensbalken (z. B. Ziel ohne HP-Daten) -->
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding StaggerOnly}">
            <ProgressBar Classes="band" Height="5" Value="{Binding StaggerPercent}" Foreground="{DynamicResource Accent.Phase}" Background="{DynamicResource Surface.Well}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="small" Text="{Binding StaggerText}" Foreground="{DynamicResource Accent.Phase}" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="rule" IsVisible="{Binding !IsCompact}" />

      <!-- ============ Spieler ============ -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340" IsVisible="{Binding !IsCompact}">
        <ItemsControl ItemsSource="{Binding Players}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PlayerRow">
              <Border Classes="prow" Classes.me="{Binding IsUser}" Classes.selected="{Binding IsSelected}" PointerPressed="OnRowPressed">
                <Grid ColumnDefinitions="24,*,Auto,52" RowDefinitions="Auto,Auto">
                  <Image Grid.RowSpan="2" Source="{Binding ClassIcon}" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Classes="shade" Classes.self="{Binding IsUser}" Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    <StackPanel Orientation="Horizontal" Spacing="3" ToolTip.Tip="{l:T row.combat_power}"
                                IsVisible="{Binding CombatPower, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <Image Source="{l:Icon bolt, Size=10}" Width="10" Height="10" Opacity="0.8" />
                      <TextBlock Classes="small muted" Text="{Binding CombatPower}" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="shade num" Text="{Binding Dps}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding Total}" />
                  <TextBlock Grid.Column="3" Classes="small secondary num" Text="{Binding Share}" VerticalAlignment="Center" />
                  <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Classes="trace" Value="{Binding BarPercent}" Foreground="{Binding ClassBrush}" Margin="6,4,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- ============ Skill-Details ============ -->
      <Border IsVisible="{Binding ShowDetails}" Background="{DynamicResource Surface.Well}" CornerRadius="{DynamicResource Radius.Control}" Padding="8,6">
        <StackPanel Spacing="3">
          <TextBlock Classes="small muted" Text="{Binding DetailsTitle}" Margin="0,0,0,2" />
          <ItemsControl ItemsSource="{Binding Skills}" MaxHeight="200">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SkillRow">
                <Grid ColumnDefinitions="26,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,3">
                  <Border Grid.RowSpan="2" Width="20" Height="20" CornerRadius="{DynamicResource Radius.Mark}" Background="{DynamicResource Surface.Well}" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" />
                  </Border>
                  <TextBlock Grid.Column="1" Classes="small" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Classes="small num" Text="{Binding Damage}" FontWeight="Medium" Margin="6,0,0,0" MinWidth="46" />
                  <TextBlock Grid.Column="3" Classes="small muted num" Text="{Binding Hits, StringFormat='{}{0}×'}" Margin="6,0,0,0" MinWidth="32" />
                  <TextBlock Grid.Column="4" Classes="small muted num" Text="{Binding Crit}" Margin="6,0,0,0" MinWidth="42" />
                  <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Classes="trace" Value="{Binding BarPercent}" Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ============ Hinweise + Fußzeile ============ -->
      <Button Classes="cta" Content="{l:T setup.button}" Command="{Binding OpenSetupCommand}"
              IsVisible="{Binding NpcapMissing}" HorizontalAlignment="Center" />
      <TextBlock Classes="small muted" Text="{l:T hint.name}" Margin="2,0" TextWrapping="Wrap"
                 IsVisible="{Binding ShowNameHint}" />
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,0" IsVisible="{Binding !IsCompact}">
        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                 Fill="{Binding IsConnected, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
        <TextBlock Grid.Column="1" Classes="small muted" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding StatusText}" />
        <TextBlock Grid.Column="2" Classes="small muted" Text="{Binding PartyDps}" Margin="8,0,0,0" />
      </Grid>
    </StackPanel>

    <!-- Schloss: Klicks gehen ins Spiel. Immer sichtbar und auch im gesperrten Zustand klickbar (Hover-Timer im Code).
         Verschoben wird über den Platzierungsmodus (Knopf mit dem Griff oder Kürzel). -->
    <ToggleButton Classes="ovl" Name="ClickThroughButton" ToolTip.Tip="{l:T header.clickthrough}" AutomationProperties.Name="Sperren"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0">
      <Panel>
        <Image Source="{l:Icon lock-open, Size=13}" Width="13" Height="13" Opacity="0.55" IsVisible="{Binding !IsClickThrough}" />
        <Image Source="{l:Icon lock, Size=13}" Width="13" Height="13" IsVisible="{Binding IsClickThrough}" />
      </Panel>
    </ToggleButton>
    </Panel>
  </Border>
</Window>
