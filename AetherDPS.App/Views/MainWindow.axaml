<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherDPS.App.ViewModels"
        xmlns:l="using:AetherDPS.App.Services"
        x:Class="AetherDPS.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{l:T app.title}"
        Width="380" MinWidth="260" SizeToContent="Height" MaxHeight="720"
        SystemDecorations="None" Topmost="True" CanResize="True" ShowActivated="False"
        TransparencyLevelHint="Transparent" Background="Transparent"
        Icon="/Assets/icon.ico">

  <Window.Styles>
    <Style Selector="Button.icon, ToggleButton.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C9CED6" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#55D4A84B" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#EEF0F3" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#8E96A3" />
    </Style>
    <!-- Zahlen mit leichtem Schatten, damit sie auf jedem Spielhintergrund lesbar bleiben -->
    <Style Selector="TextBlock.num">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="2" OffsetX="0" OffsetY="1" Color="#C0000000" />
      </Setter>
    </Style>
    <Style Selector="ProgressBar.bar">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Maximum" Value="100" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="#26000000" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="#40000000" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1C222D" />
      <Setter Property="BorderBrush" Value="#2A3240" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Window.Styles>

  <Border Name="Root" Background="#E6141820" CornerRadius="8" BorderThickness="1" Padding="6"
          BorderBrush="{Binding IsClickThrough, Converter={x:Static l:BoolBrush.LockedGoldElseSubtle}}">
    <Panel>
    <StackPanel Spacing="5">

      <!-- ============ Mini-Leiste (kein Kampf) ============ -->
      <Grid Name="CompactBar" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsCompact}" Background="Transparent" Margin="2,0">
        <Border Width="30" Height="30" CornerRadius="5" Background="#262D3A" VerticalAlignment="Center">
          <Panel>
            <Image Source="{Binding SelfIcon}" Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <Image Source="/Assets/icon.png" Width="18" Height="18" IsVisible="{Binding SelfIcon, Converter={x:Static ObjectConverters.IsNull}}" />
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="{Binding SelfName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                     Fill="{Binding IsConnected, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
            <TextBlock Text="{Binding CompactInfo}" FontSize="10" Classes="dim" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" IsVisible="{Binding #Root.IsPointerOver}">
            <Button Classes="icon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{l:T header.settings}"><Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon gear, Size=13}" Width="13" Height="13" /></Button>
            <Button Classes="icon" Click="OnCloseClicked" ToolTip.Tip="{l:T header.close}"><Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon close, Size=11}" Width="11" Height="11" /></Button>
          </StackPanel>
          <Border Width="24" />
        </StackPanel>
      </Grid>

      <!-- ============ Kampfkarte: Boss / Ziel ============ -->
      <Border Classes="card" Name="Header" Padding="8,6" IsVisible="{Binding !IsCompact}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
          <Border Grid.RowSpan="3" Width="32" Height="32" CornerRadius="5" VerticalAlignment="Top" Margin="0,1,8,0"
                  Background="{Binding IsBoss, Converter={x:Static l:BoolBrush.BossRedElseGoldTile}}">
            <Panel>
              <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon skull, Size=22}" Width="22" Height="22" IsVisible="{Binding IsBoss}" />
              <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon swords, Size=22}" Width="22" Height="22" IsVisible="{Binding !IsBoss}" />
            </Panel>
          </Border>

          <!-- Zeile 1: Kampfzeit, Tode – Knöpfe nur unter der Maus -->
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding CardLabel}" FontSize="11" Classes="dim" />
              <TextBlock Text="{Binding Duration}" FontSize="11" FontWeight="SemiBold" Foreground="#C9CED6" />
              <TextBlock Text="{Binding DeathsText}" FontSize="11" Foreground="#E0605A" IsVisible="{Binding HasDeaths}" />
              <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{l:T card.limit_tip}"
                          IsVisible="{Binding LimitText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon stopwatch, Size=11}" Width="11" Height="11" />
                <TextBlock Text="{Binding LimitText}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{Binding LimitUrgent, Converter={x:Static l:BoolBrush.ErrorRedElseText}}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,-3,-4,-3">
              <StackPanel Orientation="Horizontal" IsVisible="{Binding #Root.IsPointerOver}">
                <Button Classes="icon" Content="{Binding ViewLabel}" Command="{Binding ToggleViewCommand}" ToolTip.Tip="{l:T view.tooltip}" FontSize="10" />
                <Button Classes="icon" Command="{Binding ResetCommand}" ToolTip.Tip="{l:T header.reset}"><Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon reset, Size=13}" Width="13" Height="13" /></Button>
                <ToggleButton Classes="icon" IsChecked="{Binding ShowDetails}" Command="{Binding ToggleDetailsCommand}" ToolTip.Tip="{l:T header.details}"><Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon menu, Size=13}" Width="13" Height="13" /></ToggleButton>
                <Button Classes="icon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{l:T header.settings}"><Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon gear, Size=13}" Width="13" Height="13" /></Button>
                <Button Classes="icon" Click="OnCloseClicked" ToolTip.Tip="{l:T header.close}"><Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon close, Size=11}" Width="11" Height="11" /></Button>
              </StackPanel>
              <Border Width="22" />
            </StackPanel>
          </Grid>

          <!-- Zeile 2: Name + Leben -->
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,1,0,0">
            <TextBlock Text="{Binding TargetName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding HpPercentText}" FontSize="12" Classes="num" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasTarget}" />
          </Grid>

          <!-- Stagger-Phase: Leiste, die ihr bis 0 bringen müsst -->
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,6,0,0" IsVisible="{Binding StaggerVisible}" ZIndex="1">
            <ProgressBar Classes="bar" Height="6" CornerRadius="3" Value="{Binding StaggerPercent}" Foreground="#A970E8" Background="#22FFFFFF" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding StaggerText}" FontSize="10" Foreground="#C9A8F2" Margin="8,0,0,0" />
          </Grid>

          <!-- Zeile 3: Lebensbalken -->
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,5,0,0" IsVisible="{Binding ShowHpBar}">
            <ProgressBar Classes="bar" Height="4" CornerRadius="2" VerticalAlignment="Center"
                         Value="{Binding TargetHpPercent}" Foreground="#4FBF7A" Background="#14FFFFFF" />
            <TextBlock Grid.Column="1" Text="{Binding HpText}" FontSize="10" Classes="dim" Margin="8,0,0,0" />
          </Grid>
        </Grid>
      </Border>

      <!-- ============ Spieler ============ -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="330" IsVisible="{Binding !IsCompact}">
        <ItemsControl ItemsSource="{Binding Players}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PlayerRow">
              <Border Classes="row" Height="28" PointerPressed="OnRowPressed">
                <Panel>
                  <!-- Balken in Klassenfarbe, Länge = Schaden im Vergleich zum Besten -->
                  <ProgressBar Classes="bar" Height="28" Value="{Binding BarPercent}" Foreground="{Binding ClassBrush}" Opacity="0.55" CornerRadius="4" />
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Stretch">
                    <Border Width="28" Background="#40000000" CornerRadius="4,0,0,4">
                      <Image Source="{Binding ClassIcon}" Width="20" Height="20" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Classes="num" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                      <StackPanel Orientation="Horizontal" Spacing="3" ToolTip.Tip="{l:T row.combat_power}"
                                  IsVisible="{Binding CombatPower, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon bolt, Size=10}" Width="10" Height="10" Opacity="0.85" />
                        <TextBlock Text="{Binding CombatPower}" FontSize="10" Foreground="#B8C0CC" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Dps}" Classes="num" FontSize="13" Margin="8,0,8,0" VerticalAlignment="Center" TextAlignment="Right"
                               ToolTip.Tip="{Binding Total}" />
                    <Border Grid.Column="3" Background="#4D000000" MinWidth="50" Padding="6,0" CornerRadius="0,4,4,0">
                      <TextBlock Text="{Binding Share}" FontSize="11" Classes="num" Foreground="#F2D28B" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Border>
                  </Grid>
                </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- ============ Skill-Details ============ -->
      <Border IsVisible="{Binding ShowDetails}" Classes="card" Padding="6,5">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding DetailsTitle}" FontSize="11" Classes="dim" Margin="2,0,0,2" />
          <ItemsControl ItemsSource="{Binding Skills}" MaxHeight="190">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SkillRow">
                <Panel Height="18" Margin="0,0,0,1">
                  <ProgressBar Classes="bar" Height="18" Value="{Binding BarPercent}" Foreground="#5B8DEF" Opacity="0.25" CornerRadius="3" />
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Damage}" FontSize="11" Margin="6,0,0,0" MinWidth="44" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{Binding Hits, StringFormat='{}{0}×'}" FontSize="11" Classes="dim" Margin="6,0,0,0" MinWidth="30" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{Binding Crit}" FontSize="11" Classes="dim" Margin="6,0,0,0" MinWidth="42" TextAlignment="Right" />
                  </Grid>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ============ Hinweise + Fußzeile ============ -->
      <Button Content="{l:T setup.button}" Command="{Binding OpenSetupCommand}"
              IsVisible="{Binding NpcapMissing}" HorizontalAlignment="Center" />
      <TextBlock Text="{l:T hint.name}" FontSize="10" Classes="dim" Margin="4,0" TextWrapping="Wrap"
                 IsVisible="{Binding ShowNameHint}" />
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,0" IsVisible="{Binding !IsCompact}">
        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                 Fill="{Binding IsConnected, Converter={x:Static l:BoolBrush.ConnectedGreenElseAmber}}" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="10" Classes="dim" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding StatusText}" />
        <TextBlock Grid.Column="2" Text="{Binding PartyDps}" FontSize="10" Classes="dim" Margin="8,0,0,0" />
      </Grid>
    </StackPanel>

    <!-- Schloss: immer sichtbar und auch im gesperrten Zustand klickbar (Hover-Timer im Code) -->
    <ToggleButton Classes="icon" Name="ClickThroughButton" ToolTip.Tip="{l:T header.clickthrough}" AutomationProperties.Name="Sperren"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">
      <Panel>
        <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon lock-open, Size=13}" Width="13" Height="13" Opacity="0.55" IsVisible="{Binding !IsClickThrough}" />
        <Image Classes="ic" RenderOptions.BitmapInterpolationMode="HighQuality" Source="{l:Icon lock, Size=13}" Width="13" Height="13" IsVisible="{Binding IsClickThrough}" />
      </Panel>
    </ToggleButton>
    </Panel>
  </Border>
</Window>
