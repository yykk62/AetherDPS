<!-- Farbwelt der App (docs/DESIGN.md). Wird in App.axaml nach dem FluentTheme eingebunden und ebenso in
     den UI-Tests (AetherDPS.UiTests), damit Bilder dort genauso aussehen wie im Programm.
     Fluent-Standardfarben werden auf die Tokens aus Tokens.axaml umgebogen: Akzent ist Pergament (hell),
     nicht Gold – Gold bleibt „du“ und Rekorden vorbehalten. Keine Hex-Werte außer Transparenzen. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AetherDPS/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Akzent (Haken, Schieber, Auswahlstreifen, Fortschritt): Pergament -->
      <Color x:Key="SystemAccentColor">#F1EADB</Color>
      <Color x:Key="SystemAccentColorDark1">#DDD5C4</Color>
      <Color x:Key="SystemAccentColorDark2">#C9C0AE</Color>
      <Color x:Key="SystemAccentColorDark3">#ABA290</Color>
      <Color x:Key="SystemAccentColorLight1">#F6F0E3</Color>
      <Color x:Key="SystemAccentColorLight2">#FBF6EC</Color>
      <Color x:Key="SystemAccentColorLight3">#FFFFFF</Color>
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <FontFamily x:Key="ContentControlThemeFontFamily">Bahnschrift, Microsoft YaHei UI, Yu Gothic UI, Malgun Gothic, Segoe UI</FontFamily>

      <!-- Knöpfe (Standard = ruhig): erhabene Fläche -->
      <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource Stone700}" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Stone600}" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Stone900}" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource Stone800}" />
      <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource Parchment100}" />
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource Parchment50}" />
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource Parchment300}" />
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource Stone500}" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

      <!-- Eingabefelder: eingelassen (Mulde) -->
      <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource Stone900}" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource Stone900}" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource Stone950}" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource Stone800}" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource Stone600}" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource Stone500}" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource Aether400}" />
      <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource Parchment100}" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource Parchment100}" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource Parchment100}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource Stone400}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource Stone400}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource Stone400}" />

      <!-- Auswahllisten -->
      <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource Stone700}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource Stone600}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource Stone900}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource Aether400}" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Stone800}" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource Stone600}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource Stone700}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource Stone700}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource Stone600}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{StaticResource Stone700}" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource Parchment50}" />

      <!-- Listen: gewählte Zeile als erhabene Fläche -->
      <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="{StaticResource Stone700}" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{StaticResource Stone700}" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{StaticResource Stone700}" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{StaticResource Stone600}" />

      <!-- Haken: dunkles Häkchen auf Pergament -->
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource Stone950}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource Stone950}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource Stone950}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource Stone500}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource Parchment300}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{StaticResource Stone900}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource Stone900}" />

      <!-- Aufklappbereiche -->
      <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />

      <!-- Bildlaufleisten, Tooltips -->
      <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource Stone600}" />
      <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{StaticResource Stone500}" />
      <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{StaticResource Stone400}" />
      <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource Stone900}" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource Stone600}" />
      <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource Parchment100}" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Bausteine des neuen Designs (gelten unter .ins) -->
  <StyleInclude Source="avares://AetherDPS/Instrument.axaml" />

  <Style Selector="Image.ic">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Ältere Klassen, auf die neue Sprache abgebildet (Nebenfenster bis zu ihrem Umbau):
       card = Abschnitt auf dem Rahmen (keine Kartenwand), primary = helle Hauptaktion,
       secondary = ruhig, danger = ruhig mit rotem Wort. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0,14,0,4" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line.Frame}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Action.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAction}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Action.PrimaryHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAction}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Action.PrimaryPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAction}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
  </Style>
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAction}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Signal.Bad}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Signal.Bad}" />
  </Style>

  <!-- Knopfleiste statt Dropdown: gleich breite Felder in einer Mulde -->
  <Style Selector="ListBox.seg">
    <Setter Property="Background" Value="{DynamicResource Surface.WellDeep}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <UniformGrid Rows="1" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.seg ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.seg ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
  </Style>
  <Style Selector="ListBox.seg TextBlock">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="ListBox.seg ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <!-- Nur Icon, keine Fläche (Schließen, Aufklappen) -->
  <Style Selector="Button.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Button.plain:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
  </Style>
  <Style Selector="Button.plain:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
